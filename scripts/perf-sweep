#!/usr/bin/env python3
"""perf-sweep — find and optionally reap leftover perf-run processes.

Part of the perf measurement discipline (topics/perf.md): before a
measurement run and before a session ends, every process carrying the
run marker must be found, reported, and brought down. Debris is a
finding — it may indicate a lifecycle defect in the measured system,
not just harness sloppiness — so the default mode is report-only and
the exit code stays nonzero even after a successful reap.

Spec with post-conditions and examples: topics/helper-scripts.md.
"""

from __future__ import annotations

import argparse
import os
import re
import signal
import sys
import time
from dataclasses import dataclass
from pathlib import Path

PROC = Path("/proc")
CMD_TRUNC = 160
# A too-short marker risks matching unrelated processes; with --kill that
# is catastrophic on a shared host.
MIN_MARKER_LEN = 5
EXIT_CLEAN = 0
EXIT_DEBRIS = 10
EXIT_REMAINING = 11


@dataclass
class Finding:
    pid: int
    pgid: int | None
    start_ticks: int | None
    age: int | None
    cmd: str
    src: str  # "argv" | "env" | "group"


def nonnegative_float(value: str) -> float:
    number = float(value)
    if number < 0:
        raise argparse.ArgumentTypeError("must be non-negative")
    return number


def read_bytes(path: Path) -> bytes | None:
    try:
        return path.read_bytes()
    except OSError:
        return None


def stat_fields(pid: int) -> list[bytes] | None:
    """Fields of /proc/<pid>/stat after comm; comm may contain spaces."""
    data = read_bytes(PROC / str(pid) / "stat")
    if data is None:
        return None
    end = data.rfind(b")")
    if end < 0:
        return None
    return data[end + 2 :].split()


def ancestors(pid: int) -> set[int]:
    """This process's ancestor chain (and pid 1), never sweep targets."""
    out = {1}
    while pid > 1:
        out.add(pid)
        fields = stat_fields(pid)
        if fields is None or len(fields) < 2:
            break
        pid = int(fields[1])
    return out


def cmdline_of(pid: int) -> str | None:
    data = read_bytes(PROC / str(pid) / "cmdline")
    if not data:  # kernel thread or zombie
        return None
    return data.replace(b"\0", b" ").decode("utf-8", "replace").strip()


def environ_of(pid: int) -> str | None:
    data = read_bytes(PROC / str(pid) / "environ")
    if not data:
        return None
    return data.replace(b"\0", b" ").decode("utf-8", "replace")


def pgid_of(pid: int) -> int | None:
    try:
        return os.getpgid(pid)
    except OSError:
        return None


def identity_of(pid: int) -> tuple[int, int] | None:
    """Return (start ticks, process group) for one live PID occurrence."""
    fields = stat_fields(pid)
    if fields is None or len(fields) < 20 or fields[0:1] == [b"Z"]:
        return None
    try:
        return int(fields[19]), int(fields[2])
    except ValueError:
        return None


def age_of(pid: int, uptime: float, hz: int) -> int | None:
    fields = stat_fields(pid)
    if fields is None or len(fields) < 20:
        return None
    return max(0, int(uptime - int(fields[19]) / hz))


def all_pids() -> list[int]:
    return sorted(int(p.name) for p in PROC.iterdir() if p.name.isdigit())


def scan(
    marker: re.Pattern[str], exclude: set[int], *, use_env: bool
) -> dict[int, Finding]:
    uptime_data = read_bytes(PROC / "uptime")
    uptime = float(uptime_data.split()[0]) if uptime_data else 0.0
    hz = os.sysconf("SC_CLK_TCK")
    found: dict[int, Finding] = {}
    for pid in all_pids():
        if pid in exclude:
            continue
        cmd = cmdline_of(pid)
        if cmd is None:
            continue
        src = None
        if marker.search(cmd):
            src = "argv"
        elif use_env:
            env = environ_of(pid)
            if env is not None and marker.search(env):
                src = "env"
        if src is None:
            continue
        identity = identity_of(pid)
        found[pid] = Finding(
            pid=pid,
            pgid=identity[1] if identity is not None else None,
            start_ticks=identity[0] if identity is not None else None,
            age=age_of(pid, uptime, hz),
            cmd=cmd[:CMD_TRUNC],
            src=src,
        )
    return found


def groupmates(survivors: dict[int, Finding], exclude: set[int]) -> dict[int, Finding]:
    """Unmatched processes sharing a survivor's process group.

    These are the usual tell that the measured system, not the driver,
    spawned the debris: they inherited the group but carry no marker.
    """
    pgids = {f.pgid for f in survivors.values() if f.pgid is not None and f.pgid > 1}
    if not pgids:
        return {}
    uptime_data = read_bytes(PROC / "uptime")
    uptime = float(uptime_data.split()[0]) if uptime_data else 0.0
    hz = os.sysconf("SC_CLK_TCK")
    out: dict[int, Finding] = {}
    for pid in all_pids():
        if pid in exclude or pid in survivors:
            continue
        pgid = pgid_of(pid)
        if pgid not in pgids:
            continue
        cmd = cmdline_of(pid)
        if cmd is None:
            continue
        identity = identity_of(pid)
        out[pid] = Finding(
            pid=pid,
            pgid=pgid,
            start_ticks=identity[0] if identity is not None else None,
            age=age_of(pid, uptime, hz),
            cmd=cmd[:CMD_TRUNC],
            src="group",
        )
    return out


def emit(tag: str, f: Finding) -> None:
    print(f"{tag}: pid={f.pid} pgid={f.pgid} age={f.age}s src={f.src} cmd={f.cmd}")


def same_occurrence(finding: Finding) -> bool:
    if finding.start_ticks is None or finding.pgid is None:
        return False
    return identity_of(finding.pid) == (finding.start_ticks, finding.pgid)


def process_matches(pid: int, marker: re.Pattern[str], *, use_env: bool) -> bool:
    cmd = cmdline_of(pid)
    if cmd is None:
        return False
    if marker.search(cmd):
        return True
    if not use_env:
        return False
    env = environ_of(pid)
    return env is not None and marker.search(env) is not None


def signal_targets(
    findings: dict[int, Finding],
    pgids: set[int],
    sig: signal.Signals,
    marker: re.Pattern[str],
    *,
    use_env: bool,
) -> set[int]:
    """Signal only revalidated occurrences; return pids refused with EPERM."""
    refused: set[int] = set()
    signaled_groups: set[int] = set()
    for pgid in sorted(pgids):
        if pgid <= 1:
            continue
        owners = [
            finding
            for finding in findings.values()
            if finding.src != "group" and finding.pgid == pgid
        ]
        if not any(
            process_matches(owner.pid, marker, use_env=use_env)
            and same_occurrence(owner)
            for owner in owners
        ):
            continue
        try:
            os.killpg(pgid, sig)
        except (ProcessLookupError, PermissionError):
            pass
        else:
            signaled_groups.add(pgid)
    for pid, finding in sorted(findings.items()):
        if pid <= 1:
            continue
        if finding.pgid in signaled_groups:
            continue
        if finding.src == "group":
            continue
        if not process_matches(pid, marker, use_env=use_env):
            continue
        if not same_occurrence(finding):
            continue
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            pass
        except PermissionError:
            refused.add(pid)
    return refused


def wait_gone(findings: dict[int, Finding], grace: float) -> set[int]:
    deadline = time.monotonic() + grace
    live = {pid for pid, finding in findings.items() if same_occurrence(finding)}
    while live and time.monotonic() < deadline:
        time.sleep(0.2)
        live = {pid for pid in live if same_occurrence(findings[pid])}
    return live


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="perf-sweep",
        description="Inventory (and with --kill, reap) processes left over from "
        "marker-tagged perf measurement runs. Exit 0 only when nothing matched; "
        "10 when debris was found (even if fully reaped); 11 when debris "
        "survived the kill.",
    )
    parser.add_argument(
        "marker", help="literal run identifier matched in cmdline/environ"
    )
    parser.add_argument(
        "--kill",
        action="store_true",
        help="SIGTERM matched processes, then SIGKILL stragglers after --grace",
    )
    parser.add_argument(
        "--kill-group",
        action="store_true",
        help="with --kill, also signal each survivor's whole process group",
    )
    parser.add_argument(
        "--grace",
        type=nonnegative_float,
        default=5.0,
        help="seconds between SIGTERM and SIGKILL (default 5)",
    )
    parser.add_argument(
        "--no-environ",
        action="store_true",
        help="match argv only, skip /proc/*/environ (env matching finds "
        "measured-system children that inherited the marker env var but "
        "carry no argv marker)",
    )
    args = parser.parse_args()
    if len(args.marker) < MIN_MARKER_LEN:
        parser.error(
            f"marker shorter than {MIN_MARKER_LEN} chars is too broad to sweep safely"
        )
    if args.kill_group and not args.kill:
        parser.error("--kill-group requires --kill")
    marker = re.compile(re.escape(args.marker))
    use_env = not args.no_environ

    exclude = ancestors(os.getpid())
    survivors = scan(marker, exclude, use_env=use_env)
    mates = groupmates(survivors, exclude)
    for pid in sorted(survivors):
        emit("SURVIVOR", survivors[pid])
    for pid in sorted(mates):
        emit("GROUPMATE", mates[pid])

    if not survivors:
        print(f"CLEAN: no process matches marker {args.marker!r}")
        return EXIT_CLEAN

    reaped = 0
    remaining: set[int] = set()
    if args.kill:
        target_findings = dict(survivors)
        pgids: set[int] = set()
        if args.kill_group:
            candidate_pgids = {
                f.pgid for f in survivors.values() if f.pgid is not None and f.pgid > 1
            }
            protected_pgids = {
                pgid
                for pid in exclude
                if (pgid := pgid_of(pid)) is not None and pgid > 1
            }
            protected_matches = candidate_pgids & protected_pgids
            pgids = candidate_pgids - protected_matches
            target_findings.update(
                {
                    pid: finding
                    for pid, finding in mates.items()
                    if finding.pgid not in protected_matches
                }
            )
            for pgid in sorted(protected_matches):
                print(
                    f"PROTECTED_GROUP: pgid={pgid} "
                    "reason=contains-sweep-or-ancestor action=matched-pids-only"
                )
        refused = signal_targets(
            target_findings, pgids, signal.SIGTERM, marker, use_env=use_env
        )
        remaining = wait_gone(
            {
                pid: finding
                for pid, finding in target_findings.items()
                if pid not in refused
            },
            args.grace,
        )
        if remaining:
            kill_findings = {
                pid: target_findings[pid] for pid in remaining if pid not in refused
            }
            refused |= signal_targets(
                kill_findings, pgids, signal.SIGKILL, marker, use_env=use_env
            )
            remaining = wait_gone(
                {
                    pid: finding
                    for pid, finding in kill_findings.items()
                    if pid not in refused
                },
                2.0,
            )
        # The rescan, not signal bookkeeping, is the authoritative check.
        remaining = {
            pid for pid in remaining | refused if same_occurrence(target_findings[pid])
        }
        remaining |= set(scan(marker, exclude, use_env=use_env))
        targets = set(target_findings)
        reaped = len(targets - remaining)
        for pid in sorted(targets - remaining):
            print(f"KILLED: pid={pid}")
        for pid in sorted(remaining):
            reason = "EPERM" if pid in refused else "survived-SIGKILL"
            print(f"UNKILLABLE: pid={pid} reason={reason}")

    code = EXIT_REMAINING if remaining else EXIT_DEBRIS
    print(
        f"SWEEP: survivors={len(survivors)} groupmates={len(mates)} "
        f"reaped={reaped} remaining={len(remaining)} exit={code}"
    )
    return code


if __name__ == "__main__":
    sys.exit(main())
