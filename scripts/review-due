#!/usr/bin/env python3
"""Report when kept code has gone unreviewed long enough to deserve a review.

Counts what changed in tracked code since the strict-review marker, line 1 of
`.harsh-review` at the repository root (owned by skills/harsh-review). A
creation review is due while a code file added since the marker is unreviewed;
a periodic review is due once the changed lines or commits pass a threshold.
`hook` prints one line per due review and nothing otherwise, for a post-commit
hook. Past a larger threshold the backlog is oversized: no review is due until
the user approves skipping part of it, which `skip` records as rows in a
committed gap file that later counts start from. The tool never starts a review
or moves the marker.
Contract: topics/helper-scripts.md § review-due.
"""

from __future__ import annotations

import dataclasses
import posixpath
import re
import subprocess
import sys
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from acli import (
    ExitCode,
    add_standard_args,
    argument_parser,
    die,
    emit,
    maybe_complete,
    resolve_format,
)

CAPABILITIES = ("complete",)
EXIT_CODES = {
    4: "the marker is absent for `skip`, or names a commit this repository lacks",
    5: "`skip --to` is not after where that path is already reviewed or skipped to, "
    "or repairs a broken range with a span holding no code under its path",
}
MARKER = ".harsh-review"
SKIPS_FILE = "gaps/unreviewed-code.md"
LITERAL = "--literal-pathspecs"
CODE_SUFFIXES = frozenset(
    [
        ".py",
        ".sh",
        ".bash",
        ".zsh",
        ".js",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".jsx",
        ".c",
        ".cc",
        ".cpp",
        ".cxx",
        ".h",
        ".hh",
        ".hpp",
        ".rs",
        ".go",
        ".java",
        ".kt",
        ".rb",
        ".pl",
        ".lua",
        ".el",
        ".css",
        ".scss",
    ]
)
THIRD_PARTY_DIRS = frozenset({"node_modules", "vendor", "vendored", "third_party"})
EXECUTABLE = "100755"


def _git(repo: Path, *args: str) -> str:
    return subprocess.run(
        ["git", "-C", str(repo), *args], capture_output=True, text=True, check=True
    ).stdout


def is_code(path: str, mode: str) -> bool:
    """A source file by suffix, or an executable with no suffix such as scripts/x."""
    parts = Path(path)
    if THIRD_PARTY_DIRS.intersection(parts.parts):
        return False
    if parts.suffix:
        return parts.suffix in CODE_SUFFIXES
    return mode == EXECUTABLE


def _file_modes(repo: Path) -> dict[str, str]:
    # NUL-separated throughout: Git otherwise quotes and escapes a path with
    # non-ASCII bytes, and that printed form names no file when passed back.
    return {
        entry.split("\t", 1)[1]: entry.split()[0]
        for entry in _git(repo, "ls-files", "-s", "-z").split("\0")
        if entry
    }


def changed_code(
    repo: Path, span: str, modes: dict[str, str], within: list[str] | None = None
) -> list[tuple[str, str]]:
    """(status, path) of code files changed in `span`, optionally under `within`.

    Names only: listing changed paths reads no file content, so a range full of
    large prose changes costs nothing before the code paths are selected.
    """
    command = [LITERAL, "diff", "--name-status", "--no-renames", "-z", span]
    fields = _git(repo, *command, "--", *(within or ["."])).split("\0")
    return [
        (status, path)
        for status, path in zip(fields[0::2], fields[1::2], strict=False)
        if is_code(path, modes.get(path, ""))
    ]


def changed_line_counts(repo: Path, span: str, paths: list[str]) -> dict[str, int]:
    """Added plus deleted lines per path in `span`; binary files count nothing."""
    counts = {}
    numstat = _git(
        repo, LITERAL, "diff", "--numstat", "--no-renames", "-z", span, "--", *paths
    )
    for row in numstat.split("\0"):
        if row:
            added, deleted, path = row.split("\t", 2)
            if added != "-":
                counts[path] = int(added) + int(deleted)
    return counts


def _is_ancestor(repo: Path, older: str, newer: str) -> bool:
    command = ["git", "-C", str(repo), "merge-base", "--is-ancestor", older, newer]
    return subprocess.run(command, capture_output=True, check=False).returncode == 0


def _commit_exists(repo: Path, rev: str) -> bool:
    command = ["git", "-C", str(repo), "cat-file", "-e", f"{rev}^{{commit}}"]
    return subprocess.run(command, capture_output=True, check=False).returncode == 0


def _repo_path(given: str) -> str:
    """A `--path` in the form Git prints paths, so a row matches changed files."""
    path = posixpath.normpath(given)
    if path.startswith(("/", "..")) or "`" in path:
        die(f"--path must be a plain path inside the repository: {given}")
    return path


def _commits_between(repo: Path, older: str, newer: str) -> int:
    return int(_git(repo, "rev-list", "--count", f"{older}..{newer}"))


@dataclass(frozen=True)
class SkippedRange:
    """Code under `path` changed in `base..end` that the user agreed not to review."""

    path: str
    base: str
    end: str
    lines: int
    commits: int
    skipped: str
    reason: str

    def covers(self, path: str) -> bool:
        return self.path == "." or path == self.path or path.startswith(self.path + "/")

    def as_dict(self) -> dict:
        return dataclasses.asdict(self)

    def as_row(self) -> str:
        return (
            f"- `{self.path}` `{self.base}..{self.end}` {self.lines} lines, "
            f"{self.commits} commits; skipped {self.skipped}: {self.reason}"
        )


_SKIP_ROW = re.compile(
    r"^- `(?P<path>[^`]+)` `(?P<base>[0-9a-f]{40})\.\.(?P<end>[0-9a-f]{40})` "
    r"(?P<lines>\d+) lines, (?P<commits>\d+) commits; "
    r"skipped (?P<skipped>\d{4}-\d{2}-\d{2}): (?P<reason>.*)$"
)


SKIPS_PREAMBLE = """\
---
slug: unreviewed-code
noticed: {today}
where: the paths and commit ranges listed below
---

**Gap:** code changed in these ranges never had the strict review. The user
approved skipping each so that automatic reviews could resume from a point
small enough to act on. Each list line below is one skipped range: a path,
the commits in which its code changes went unreviewed, and their size.
`review-due skip` adds a line and `review-due` starts counting that path
after its range.
**Fix sketch:** strict-review one line's path over its range, then remove the
line (`review-due unskip --path <path>`, or by hand). Remove this file with
its last line.

## Skipped ranges
"""

_LIST_LINE = "- `"


@dataclass
class SkipRecord:
    """The committed file of approved skips, as its lines in file order.

    A line is a range, or text kept exactly where it was written: prose, or a
    list line a hand edit left unreadable, which is reported and never dropped.
    """

    file: Path
    entries: list[SkippedRange | str]

    @classmethod
    def load(cls, file: Path) -> SkipRecord:
        if not file.is_file():
            today = datetime.now(timezone.utc).date().isoformat()
            return cls(file, SKIPS_PREAMBLE.format(today=today).splitlines())
        record = cls(file, [])
        lines = file.read_text().splitlines()
        at = 0
        while at < len(lines):
            line = lines[at]
            at += 1
            if not line.startswith(_LIST_LINE):
                record.entries.append(line)
                continue
            # A list line wrapped by hand continues on the indented lines after it.
            after = at
            while after < len(lines) and lines[after][:1].isspace():
                after += 1
            wrapped = [part.strip() for part in lines[at:after]]
            fields = _SKIP_ROW.match(" ".join([line, *wrapped]))
            if not fields:
                record.entries.append(line)
                continue
            counts = {"lines": int(fields["lines"]), "commits": int(fields["commits"])}
            record.entries.append(SkippedRange(**{**fields.groupdict(), **counts}))
            at = after
        return record

    @property
    def ranges(self) -> list[SkippedRange]:
        return [entry for entry in self.entries if isinstance(entry, SkippedRange)]

    @property
    def unreadable(self) -> list[str]:
        return [
            entry
            for entry in self.entries
            if isinstance(entry, str) and entry.startswith(_LIST_LINE)
        ]

    def _list_end(self) -> int:
        """Index just past the last list line, or -1 when the file has none."""
        listed = [
            index
            for index, entry in enumerate(self.entries)
            if isinstance(entry, SkippedRange) or entry.startswith(_LIST_LINE)
        ]
        return listed[-1] + 1 if listed else -1

    def put(self, row: SkippedRange, replacing: list[SkippedRange]) -> None:
        """Add `row` where the first of `replacing` stood, else to the list's end."""
        at = self._list_end()
        if replacing:
            at = self.entries.index(replacing[0])
        elif at < 0:
            at = len(self.entries)
            if self.entries and self.entries[-1] != "":
                self.entries.append("")
                at += 1
        self.entries.insert(at, row)
        self.remove(replacing)

    def remove(self, rows: list[SkippedRange]) -> None:
        self.entries = [entry for entry in self.entries if entry not in rows]

    def save(self) -> None:
        """Write the file, or remove it once it lists nothing."""
        if self._list_end() < 0:
            self.file.unlink(missing_ok=True)
            return
        self.file.parent.mkdir(parents=True, exist_ok=True)
        lines = [
            entry.as_row() if isinstance(entry, SkippedRange) else entry
            for entry in self.entries
        ]
        self.file.write_text("\n".join(lines) + "\n")


@dataclass(frozen=True)
class Settings:
    """Thresholds for a due review, the size past which one review is too much,
    and the committed record of ranges the user agreed to skip."""

    max_lines: int
    max_commits: int
    max_review_lines: int
    max_review_commits: int
    skips_file: str


def reviewed_marker(repo: Path) -> str | None:
    """The commit the strict review has reached, or None when not enrolled."""
    marker = repo / MARKER
    if not marker.is_file():
        return None
    lines = marker.read_text().splitlines()
    reviewed = lines[0].strip() if lines else ""
    try:
        _git(repo, "cat-file", "-e", f"{reviewed}^{{commit}}")
    except subprocess.CalledProcessError:
        die(
            f"{MARKER} line 1 is not a commit in this repository",
            ExitCode.NOT_FOUND,
            detail={"marker": str(marker), "line": reviewed},
        )
    return reviewed


NOT_ENROLLED = {
    "reviewed": None,
    "skips_needing_repair": [],
    "skips_unreadable": [],
    "due": [],
}


def unreviewed_code(
    repo: Path, settings: Settings, record: SkipRecord | None = None
) -> dict:
    """Count code changed since the marker and say which reviews that makes due.

    `record` stands in for the record file, to preview a skip.
    """
    reviewed = reviewed_marker(repo)
    if reviewed is None:
        return dict(NOT_ENROLLED)
    modes = _file_modes(repo)
    record = record or SkipRecord.load(repo / settings.skips_file)
    rows = record.ranges
    # A rebase can leave a range ending at a commit that is gone or off this
    # history; it then stops applying, so it is reported for repair.
    lost = [row for row in rows if not _is_ancestor(repo, row.end, "HEAD")]
    skips = [
        row
        for row in rows
        if row not in lost
        and row.end != reviewed
        and _is_ancestor(repo, reviewed, row.end)
    ]
    # Each file is measured from its own start: the end of the furthest approved
    # skip covering it, else the marker.
    depth = {row.end: _commits_between(repo, reviewed, row.end) for row in skips}
    by_start: dict[str, list[str]] = {}
    since_marker = changed_code(repo, f"{reviewed}..HEAD", modes)
    for _, path in since_marker:
        covering = [row.end for row in skips if row.covers(path)]
        start = max(covering, key=depth.__getitem__) if covering else reviewed
        by_start.setdefault(start, []).append(path)
    changed_lines = 0
    commits: set[str] = set()
    new_files = []
    by_subtree: dict[str, int] = {}
    for start, paths in by_start.items():
        span = f"{start}..HEAD"
        # The marker's own group was just listed; only a skip's later start
        # needs its own listing to tell which files are new since then.
        group = set(paths)
        listed = (
            [entry for entry in since_marker if entry[1] in group]
            if start == reviewed
            else changed_code(repo, span, modes, paths)
        )
        new_files += [path for status, path in listed if status == "A"]
        for path, count in changed_line_counts(repo, span, paths).items():
            changed_lines += count
            top = path.split("/", 1)[0] if "/" in path else "."
            by_subtree[top] = by_subtree.get(top, 0) + count
        commits.update(_git(repo, LITERAL, "rev-list", span, "--", *paths).split())
    oversized = (
        changed_lines > settings.max_review_lines
        or len(commits) > settings.max_review_commits
    )
    due = []
    if oversized:
        due.append("oversized")
    else:
        if new_files:
            due.append("creation")
        if changed_lines > settings.max_lines or len(commits) > settings.max_commits:
            due.append("periodic")
    largest = sorted(by_subtree.items(), key=lambda item: -item[1])[:8]
    return {
        "reviewed": reviewed,
        "head": _git(repo, "rev-parse", "HEAD").strip(),
        "changed_lines": changed_lines,
        "commits": len(commits),
        "new_files": sorted(new_files),
        "max_lines": settings.max_lines,
        "max_commits": settings.max_commits,
        "max_review_lines": settings.max_review_lines,
        "max_review_commits": settings.max_review_commits,
        "by_subtree": dict(largest),
        "skips_in_effect": [row.as_dict() for row in skips],
        "skips_needing_repair": [row.as_dict() for row in lost],
        "skips_unreadable": record.unreadable,
        "due": due,
    }


def due_lines(result: dict) -> list[str]:
    lines = []
    if "creation" in result["due"]:
        files = result["new_files"]
        shown = ", ".join(files[:3]) + (
            f", +{len(files) - 3} more" if files[3:] else ""
        )
        lines.append(f"review-due: creation review due for new kept code: {shown}")
    if "periodic" in result["due"]:
        lines.append(
            f"review-due: periodic review due: {result['changed_lines']} changed code "
            f"lines in {result['commits']} commits since {result['reviewed'][:12]}"
        )
    for row in result["skips_needing_repair"]:
        lines.append(
            f"review-due: the skipped range for `{row['path']}` ends at {row['end'][:12]}, "
            "which is no longer in this history, so it has stopped applying; repair it "
            f"with `review-due skip --path {row['path']} --to <commit-it-became>`"
        )
    for line in result["skips_unreadable"]:
        lines.append(f"review-due: unreadable skipped-range line, ignored: {line}")
    if "oversized" in result["due"]:
        largest = ", ".join(
            f"{path} {count}" for path, count in list(result["by_subtree"].items())[:3]
        )
        lines.append(
            f"review-due: oversized backlog, start no review: {result['changed_lines']} "
            f"changed code lines in {result['commits']} commits since "
            f"{result['reviewed'][:12]} (largest: {largest}); ask the user to approve a "
            "cut, then record it with `review-due skip`"
        )
    return lines


def _settings(args) -> Settings:
    return Settings(
        args.max_lines,
        args.max_commits,
        args.max_review_lines,
        args.max_review_commits,
        args.skips_file,
    )


def skip(args) -> int:
    repo = Path(args.repo).resolve()
    reviewed = reviewed_marker(repo)
    if reviewed is None:
        die(f"No {MARKER} marker: nothing is counted here yet", ExitCode.NOT_FOUND)
    if not _commit_exists(repo, args.to):
        die(f"--to {args.to} is not a commit here", ExitCode.NOT_FOUND)
    end = _git(repo, "rev-parse", "--verify", f"{args.to}^{{commit}}").strip()
    if not _is_ancestor(repo, end, "HEAD"):
        die(f"--to {end[:12]} is not in HEAD's history", ExitCode.CONFLICT)
    if args.reason is not None and ("\n" in args.reason or not args.reason.strip()):
        die("--reason must be one nonempty line")
    record = SkipRecord.load(repo / args.skips_file)
    modes = _file_modes(repo)
    today = datetime.now(timezone.utc).date().isoformat()
    added = []
    repaired = []
    unchanged = []
    for path in dict.fromkeys(map(_repo_path, args.path or ["."])):
        own = [row for row in record.ranges if row.path == path]
        # Repair: this path's range that a rebase left ending off this history
        # is replaced, keeping its start when that commit survived.
        broken = [row for row in own if not _is_ancestor(repo, row.end, "HEAD")]
        # Extend this path's own earlier skip when it reaches the marker or past it.
        earlier = [
            row
            for row in own
            if row not in broken and _is_ancestor(repo, reviewed, row.end)
        ]
        kept_start = [row.base for row in broken if _is_ancestor(repo, row.base, end)]
        base = earlier[0].base if earlier else (kept_start or [reviewed])[0]
        reached = earlier[-1].end if earlier else reviewed
        if not broken and (reached == end or not _is_ancestor(repo, reached, end)):
            die(
                f"--to {end[:12]} is not after {reached[:12]}, where `{path}` is "
                "reviewed or skipped to",
                ExitCode.CONFLICT,
            )
        span = f"{base}..{end}"
        paths = [name for _, name in changed_code(repo, span, modes, [path])]
        if not paths and broken:
            die(
                f"no code changed under `{path}` in {base[:12]}..{end[:12]}, so the "
                "broken range is kept: pass the commit its end became as --to, or "
                f"`unskip --path {path}` if the rewrite removed that code",
                ExitCode.CONFLICT,
            )
        if not paths:
            unchanged.append(path)
            continue
        # A repair alone restates what the user approved, so it keeps that
        # approval's reason and date; a new or extended range records its own.
        approved = broken[0] if broken and not earlier else None
        if approved is None and args.reason is None:
            die(f"--reason is required: `{path}` has no broken range to repair")
        row = SkippedRange(
            path,
            base,
            end,
            sum(changed_line_counts(repo, span, paths).values()),
            len(_git(repo, LITERAL, "rev-list", span, "--", *paths).split()),
            approved.skipped if approved else today,
            approved.reason if approved else args.reason,
        )
        record.put(row, replacing=broken + earlier)
        added.append(row)
        if approved:
            repaired.append({"was": approved.as_dict(), "now": row.as_dict()})
    result = {
        "record": str(record.file),
        "written": not args.dry_run,
        "skipped": [row.as_dict() for row in added],
        "repaired": repaired,
        "no_code_changed": unchanged,
    }
    if not args.dry_run:
        record.save()
    remaining = result["remaining"] = unreviewed_code(repo, _settings(args), record)
    emit(
        result,
        resolve_format(args),
        text="\n".join(
            [
                *(row.as_row() for row in added),
                *(
                    f"repaired `{pair['now']['path']}`: was {pair['was']['lines']} "
                    f"lines, {pair['was']['commits']} commits to "
                    f"{pair['was']['end'][:12]}; now {pair['now']['lines']} lines, "
                    f"{pair['now']['commits']} commits to {pair['now']['end'][:12]}"
                    for pair in repaired
                ),
                *(f"no code changed under `{path}`; no row" for path in unchanged),
                f"remaining: {remaining['changed_lines']} changed code lines in "
                f"{remaining['commits']} commits; due: "
                + (", ".join(remaining["due"]) or "nothing"),
            ]
        ),
    )
    return 0


def unskip(args) -> int:
    """Drop the rows for paths whose skipped ranges a review has now covered."""
    record = SkipRecord.load(Path(args.repo).resolve() / args.skips_file)
    named = set(map(_repo_path, args.path))
    removed = [row for row in record.ranges if row.path in named]
    if not removed:
        die("No skipped range has that path", ExitCode.NOT_FOUND)
    record.remove(removed)
    record.save()
    emit(
        {
            "record": str(record.file),
            "removed": [row.as_dict() for row in removed],
            "record_deleted": not record.file.exists(),
        },
        resolve_format(args),
        text="\n".join(f"removed {row.as_row()}" for row in removed),
    )
    return 0


def status(args) -> int:
    result = unreviewed_code(Path(args.repo).resolve(), _settings(args))
    if result["reviewed"] is None:
        text = (
            f"no {MARKER} marker; nothing is counted until a strict review writes one"
        )
    else:
        text = "\n".join(due_lines(result)) or (
            f"review-due: nothing due ({result['changed_lines']} changed code lines in "
            f"{result['commits']} commits since {result['reviewed'][:12]})"
        )
    emit(result, resolve_format(args), text=text)
    return 0


def hook(args) -> int:
    result = unreviewed_code(Path(args.repo).resolve(), _settings(args))
    for line in due_lines(result):
        print(line)
    return 0


def build_parser():
    parser = argument_parser(
        prog="review-due",
        description="Report when tracked code has changed enough since the strict-review "
        f"marker ({MARKER} line 1) that a review is due. Never starts a review or moves "
        "the marker. Contract: topics/helper-scripts.md § review-due.",
        capabilities=CAPABILITIES,
        exit_codes=EXIT_CODES,
    )
    parser.add_argument(
        "--repo", default=".", help="Repository to survey (default: current directory)."
    )
    parser.add_argument(
        "--max-lines",
        type=int,
        default=400,
        help="Changed code lines above which a periodic review is due (default 400).",
    )
    parser.add_argument(
        "--max-commits",
        type=int,
        default=20,
        help="Code-touching commits above which a periodic review is due (default 20).",
    )
    parser.add_argument(
        "--max-review-lines",
        type=int,
        default=6000,
        help="Changed code lines above which the backlog is oversized: no automatic "
        "review, and the user is asked to approve a cut (default 6000).",
    )
    parser.add_argument(
        "--max-review-commits",
        type=int,
        default=120,
        help="Code-touching commits above which the backlog is oversized (default 120).",
    )
    parser.add_argument(
        "--skips-file",
        default=SKIPS_FILE,
        help="Committed record of ranges the user approved skipping, relative to the "
        f"repository (default {SKIPS_FILE}).",
    )
    commands = parser.add_subparsers(dest="command", required=True)
    skip_cmd = commands.add_parser(
        "skip",
        help="Record, after the user approves it, that code changed up to --to is "
        "skipped without review: one row per --path in the --skips-file, counted from "
        "where that path is already reviewed or skipped to. Never moves the marker.",
    )
    skip_cmd.add_argument(
        "--to",
        required=True,
        help="Last skipped commit; for a cut at a feature's first commit F, pass F^.",
    )
    skip_cmd.add_argument(
        "--path",
        action="append",
        default=None,
        help="Subtree or file to skip, repeatable (default: the whole repository).",
    )
    skip_cmd.add_argument(
        "--reason",
        help="Why the range is skipped, in one line. Required except to repair a "
        "range whose end left this history, which keeps its approved reason and date.",
    )
    skip_cmd.add_argument(
        "--dry-run",
        action="store_true",
        help="Report the rows and what would remain to review; write nothing.",
    )
    add_standard_args(skip_cmd)
    skip_cmd.set_defaults(func=skip)
    unskip_cmd = commands.add_parser(
        "unskip",
        help="Remove the skipped-range rows for the given paths, once a review has "
        "covered them; deletes the record file with its last row.",
    )
    unskip_cmd.add_argument(
        "--path", action="append", required=True, help="Row path, repeatable."
    )
    add_standard_args(unskip_cmd)
    unskip_cmd.set_defaults(func=unskip)
    status_cmd = commands.add_parser(
        "status",
        help="Emit the counts, the new code files, the largest subtrees, the skips in "
        "effect, and which reviews are due (creation, periodic, or oversized).",
    )
    add_standard_args(status_cmd)
    status_cmd.set_defaults(func=status)
    hook_cmd = commands.add_parser(
        "hook",
        help="Print one `review-due:` line per due review and nothing otherwise; always "
        "exits 0 unless the marker is invalid. For a post-commit hook, which passes "
        "--acli-quiet so stderr stays empty too.",
    )
    add_standard_args(hook_cmd)
    hook_cmd.set_defaults(func=hook)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    maybe_complete(parser, [sys.argv[0], *(argv if argv is not None else sys.argv[1:])])
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except subprocess.CalledProcessError as exc:
        die(
            f"git failed: {' '.join(exc.cmd)}",
            ExitCode.SOFTWARE,
            detail={"stderr": (exc.stderr or "").strip()},
        )


if __name__ == "__main__":
    sys.exit(main())
