    Group("other", "**Other activities.**", ()),
)

ROW = re.compile(
    r"^\| `(?P<name>[^`]+)` \| Governs: (?P<activity>[^|]+?) \| "
    r"\[[^\]]*\]\((?P<path>[^)]+)\) \|\s*$"
)


class BuildError(Exception):
    def __init__(self, message: str, code: ExitCode, **detail: object) -> None:
        super().__init__(message)
        self.code = code
        self.detail = detail


def governs_rows(glossary: str) -> list[tuple[str, str, str]]:
    rows = []
    for line in glossary.splitlines():
        match = ROW.match(line)
        if match:
            rows.append(
                (match["name"], match["activity"].strip(), match["path"].strip())
            )
    if not rows:
        raise BuildError(f"no Governs rows in {GLOSSARY}", ExitCode.NOT_FOUND)
    return rows


def route_path(path: str) -> str:
    if path.startswith("topics/") and path.endswith(".md") and path.count("/") == 1:
        return path[len("topics/") : -len(".md")]
    return f"~/agents/{path}"


def activity_routes(glossary: str) -> tuple[str, list[str]]:
    """Render the grouped route section and the topics no group names."""
    rows = governs_rows(glossary)
    by_group: dict[str, list[tuple[str, str, str]]] = {g.key: [] for g in GROUPS}
    placement = {topic: g.key for g in GROUPS for topic in g.topics}
    unclassified = []
    for name, activity, path in rows:
        key = placement.get(name)
        if key is None:
            key = "other"
            unclassified.append(name)
        by_group[key].append((name, activity, path))
    order = {topic: i for g in GROUPS for i, topic in enumerate(g.topics)}
    lines = [
        "## Activity routes",
        "",
        "Before starting an activity listed below, read the named topic. A",
        "bare topic name means the repo's own `topics/<name>.md` first, else",
        "`~/agents/topics/<name>.md`. The trigger is the activity, never an",
        "occurrence of the word. Generated from the Governs rows of",
        "`~/agents/GLOSSARY.agents.md`; edit a topic's `Governs:` line and its",
        "row, not this section.",
    ]
    for group in GROUPS:
        members = sorted(by_group[group.key], key=lambda r: order.get(r[0], 1 << 30))
        if not members:
            continue
        lines += ["", group.condition, ""]
        lines += [
            f"- {activity} → `{route_path(path)}`" for _, activity, path in members
        ]
    return "\n".join(lines) + "\n", unclassified


def replace_section(
    text: str, section: str, begin: str = BEGIN, end_marker: str = END
) -> str:
    start = text.find(begin)
    end = text.find(end_marker)
    if text.count(begin) != 1 or text.count(end_marker) != 1 or end < start:
        raise BuildError(
            f"{GLOBAL} lacks the generated-section markers",
            ExitCode.NOT_FOUND,
            begin=begin,
            end=end_marker,
        )
    return text[: start + len(begin)] + "\n" + section + text[end:]


def reread_excerpt(source: str, name: str) -> str:
    """Extract important content without copying the source's conditional material."""
    lines = []
    opened = False
    for line in source.splitlines():
        if line == "<!-- reread:begin -->":
            if opened:
                raise BuildError(f"nested reread block in {name}", ExitCode.DATA)
            opened = True
        elif line == "<!-- reread:end -->":
            if not opened:
                raise BuildError(f"unmatched reread end in {name}", ExitCode.DATA)
            opened = False
            lines.append("")
        elif line.startswith("<!-- reread:include ") and line.endswith(" -->"):
            continue
        elif line.startswith("<!-- reread:"):
            raise BuildError(f"invalid reread marker in {name}", ExitCode.DATA)
        elif opened:
            lines.append(line)
    if opened:
        raise BuildError(f"unclosed reread block in {name}", ExitCode.DATA)
    return "\n".join(lines).strip()


def compile_rereads(
    repo: Path, sources: dict[Path, str] | None = None
) -> tuple[str, dict[Path, str]]:
    """Compile direct and recursive rereads, including coverage for read observers."""
    if sources is None:
        sources = {
            path.resolve(): path.read_text()
            for path in sorted((repo / "topics").glob("*.md"))
            if ".mandatory-reread" not in path.name
        }
    excerpts = {
        path: reread_excerpt(source, str(path.relative_to(repo)))
        for path, source in sources.items()
    }
    dependencies: dict[Path, list[Path]] = {}
    for path, source in sources.items():
        linked = []
        for target in re.findall(r"\[[^\]]*\]\(([^)]+)\)", source):
            url = urlsplit(target)
            if not url.scheme and not url.netloc and url.path:
                resolved = (path.parent / unquote(url.path)).resolve()
                if resolved in sources:
                    linked.append(resolved)
        for target in re.findall(
            r"^<!-- reread:include (.+) -->$", source, re.MULTILINE
        ):
            resolved = (path.parent / target).resolve()
            if resolved not in sources:
                raise BuildError(
                    f"missing reread dependency {target} in {path.name}",
                    ExitCode.NOT_FOUND,
                )
            linked.append(resolved)
        dependencies[path] = list(dict.fromkeys(linked))

    def reachable(path: Path, seen: set[Path]) -> list[Path]:
        if path in seen:
            return []
        seen.add(path)
        return [path] + [
            item
            for dependency in dependencies[path]
            for item in reachable(dependency, seen)
        ]

    outputs = {}
    registry = []
    for path, source in sources.items():
        condition = re.findall(r"^Mandatory-reread: (.+)$", source, re.MULTILINE)
        if len(condition) > 1 or (condition and not excerpts[path]):
            raise BuildError(
                f"{path.name} needs one reread condition and nonempty marked content",
                ExitCode.DATA,
            )
        if not excerpts[path]:
            continue
        for recursive in (False, True):
            visited = reachable(path, set()) if recursive else [path]
            covered = [item for item in visited if excerpts[item]]
            coverage = {
                str(item.relative_to(repo)): hashlib.sha256(
                    excerpts[item].encode()
                ).hexdigest()
                for item in covered
            }
            source_hashes = {
                str(item.relative_to(repo)): hashlib.sha256(
                    sources[item].encode()
                ).hexdigest()
                for item in covered
            }
            suffix = (
                ".mandatory-reread.recursive.md"
                if recursive
                else ".mandatory-reread.md"
            )
            output = path.with_suffix(suffix)
            body = "\n\n".join(
                f"<!-- source: {item.relative_to(repo)} -->\n{excerpts[item]}"
                for item in covered
            )
            outputs[output] = (
                "<!-- Generated by scripts/build-boot; edit the base topics. -->\n"
                f"<!-- reread-coverage: {json.dumps(coverage, sort_keys=True)} -->\n"
                f"<!-- reread-source-hashes: {json.dumps(source_hashes, sort_keys=True)} -->\n"
                f"# Required reread: {path.stem}\n\n"
                + (f"Applies {condition[0]}.\n\n" if condition else "")
                + body
                + "\n"
            )
        if condition:
            registry.append(
                f"- {condition[0]} → `{path.stem}.mandatory-reread.recursive.md`"
            )
    return "\n".join(registry) + "\n", outputs


def boot_text(global_text: str, user_text: str) -> str:
    return (
        "<!-- Generated by ~/agents/scripts/build-boot from AGENTS.global.md and "
        "AGENTS.user.md; edit those sources. -->\n"
        + global_text.rstrip("\n")
        + "\n\n"
        + USER_HEADING
        + "\n\n"
        + user_text.rstrip("\n")
        + "\n"
    )


def _read(repo: Path, name: str) -> str:
    path = repo / name
    if not path.is_file():
        raise BuildError(f"missing source {path}", ExitCode.NOT_FOUND, path=str(path))
    return path.read_text()


def _git(repo: Path, *args: str, stdin: str | None = None) -> str:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        input=stdin,
        capture_output=True,
        text=True,
        check=True,
    ).stdout


def _write_atomic(path: Path, text: str) -> None:
    with tempfile.NamedTemporaryFile(
        "w", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as stream:
        stream.write(text)
        temporary = Path(stream.name)
    if path.exists():
        os.chmod(temporary, path.stat().st_mode & 0o7777)
    os.replace(temporary, path)


def _stage_global(repo: Path) -> bool:
    """Regenerate the section inside the staged AGENTS.global.md blob.

    Works on the index copy so unstaged edits elsewhere in the file stay
    out of the commit being made.
    """
    staged = _git(repo, "show", f":{GLOBAL}")
    section, _ = activity_routes(_git(repo, "show", f":{GLOSSARY}"))
    updated = replace_section(staged, section)
    sources = {
        (repo / name).resolve(): _git(repo, "show", f":{name}")
        for name in _git(repo, "ls-files", "--", "topics/*.md").splitlines()
        if ".mandatory-reread" not in name
    }
    registry, _ = compile_rereads(repo, sources)
    updated = replace_section(updated, registry, REREAD_BEGIN, REREAD_END)
    if updated == staged:
        return False
    blob = _git(repo, "hash-object", "-w", "--stdin", stdin=updated).strip()
    mode = _git(repo, "ls-files", "-s", "--", GLOBAL).split()[0]
    _git(repo, "update-index", "--cacheinfo", f"{mode},{blob},{GLOBAL}")
    return True


def build(args) -> int:
    repo = Path(args.repo).resolve()
    boot_path = Path(args.output).expanduser() if args.output else repo / BOOT
    global_text = _read(repo, GLOBAL)
    section, unclassified = activity_routes(_read(repo, GLOSSARY))
    new_global = replace_section(global_text, section)
    registry, rereads = compile_rereads(repo)
    new_global = replace_section(new_global, registry, REREAD_BEGIN, REREAD_END)
    if new_global.count(COMPACT_BEGIN) != 1 or new_global.count(COMPACT_END) != 1:
        raise BuildError("missing or duplicate on-compact markers", ExitCode.NOT_FOUND)
    compact_start = new_global.index(COMPACT_BEGIN) + len(COMPACT_BEGIN)
    compact_end = new_global.index(COMPACT_END)
    if compact_end < compact_start:
        raise BuildError("reversed on-compact markers", ExitCode.DATA)
    compact_path = boot_path.with_name(ON_COMPACT)
    compact_text = (
        "<!-- Generated by scripts/build-boot from AGENTS.global.md. -->\n"
        "# After compaction\n\n" + new_global[compact_start:compact_end].strip() + "\n"
    )
    new_boot = boot_text(new_global, _read(repo, USER))
    old_boot = boot_path.read_text() if boot_path.is_file() else None
    stale = {
        "global_section": new_global != global_text,
        "boot": new_boot != old_boot,
    }
    outputs = {compact_path: compact_text, **rereads}
    for harness in HARNESSES:
        source = repo / f"AGENTS.{harness}.md"
        if source.is_file():
            outputs[boot_path.with_name(harness_boot(harness))] = (
                new_boot
                + f"\n# Harness policy (compiled from {source.name})\n\n"
                + source.read_text().rstrip()
                + "\n"
            )
    stale.update(
        {
            str(path): not path.is_file() or path.read_text() != text
            for path, text in outputs.items()
        }
    )
    staged = False
    if not args.check:
        if args.index:
            staged = _stage_global(repo)
        if stale["global_section"]:
            _write_atomic(repo / GLOBAL, new_global)
        if stale["boot"]:
            _write_atomic(boot_path, new_boot)
        for path, text in outputs.items():
            if stale[str(path)]:
                _write_atomic(path, text)
    result = {
        "boot": str(boot_path),
        "on_compact": str(compact_path),
        "mandatory_rereads": [str(path) for path in rereads],
        "checked_only": args.check,
        "stale": stale,
        "staged_global": staged,
        "unclassified_topics": unclassified,
    }
    emit(result, resolve_format(args), text=_build_text(result))
    return int(ExitCode.DATA) if args.check and any(stale.values()) else 0


def _build_text(result: dict) -> str:
    verb = "stale" if result["checked_only"] else "rebuilt"
    parts = [f"{name} {verb}" for name, flag in result["stale"].items() if flag]
    line = ", ".join(parts) if parts else "up to date"
    if result["unclassified_topics"]:
        line += "; unclassified: " + ", ".join(result["unclassified_topics"])
    return f"{result['boot']}: {line}"


def _targets() -> list[Path]:
    config = CONFIG.expanduser()
    if config.is_file():
        try:
            values = json.loads(config.read_text())["targets"]
        except (json.JSONDecodeError, KeyError, TypeError) as exc:
            raise BuildError(
                f'{config} needs a JSON object with a "targets" list',
                ExitCode.USAGE,
                path=str(config),
                reason=str(exc),
            ) from exc
    else:
        values = DEFAULT_TARGETS
    return [Path(value).expanduser() for value in values]


def link(args) -> int:
    repo = Path(args.repo).resolve()
    boot = repo / BOOT
    sources = {(repo / GLOBAL).resolve(), boot.resolve()}
    sources.update((repo / harness_boot(h)).resolve() for h in HARNESSES)
    destination = (repo / GLOBAL) if args.to_global else boot
    if not destination.is_file():
        raise BuildError(
            f"{destination} does not exist; run build first",
            ExitCode.NOT_FOUND,
            path=str(destination),
        )
    rows = []
    for path in _targets():
        harness = target_harness(path)
        destination = (repo / GLOBAL) if args.to_global else boot
        if harness and not args.to_global:
            destination = repo / harness_boot(harness)
        if not path.is_symlink():
            state = "absent" if not path.exists() else "not-a-symlink"
            rows.append({"path": str(path), "action": "skip", "state": state})
            continue
        current = (path.parent / os.readlink(path)).resolve()
        if current == destination.resolve():
            rows.append({"path": str(path), "action": "keep", "target": str(current)})
            continue
        if current not in sources:
            rows.append(
                {
                    "path": str(path),
                    "action": "skip",
                    "state": "foreign",
                    "target": str(current),
                }
            )
            continue
        if not destination.is_file():
            raise BuildError(
                f"missing {destination}; run build with its harness supplement",
                ExitCode.NOT_FOUND,
            )
        if not args.check:
            temporary = path.with_name(f".{path.name}.build-boot")
            os.symlink(destination, temporary)
            os.replace(temporary, path)
        rows.append(
            {
                "path": str(path),
                "action": "stale" if args.check else "retarget",
                "previous": str(current),
                "target": str(destination),
            }
        )
    rows += _disable_misdirected(repo, check=args.check)
    emit(rows, resolve_format(args), text="\n".join(_link_line(r) for r in rows))
    stale = any(row["action"] in ("stale", "misdirected") for row in rows)
    return int(ExitCode.DATA) if stale else 0


def _disable_misdirected(repo: Path, *, check: bool) -> list[dict]:
    """Rename discovery-directory links that resolve to the checkout or above.

    Renaming rather than deleting keeps the link target recoverable with `mv`.
    """
    rows = []
    for value in DISCOVERY_DIRS:
        path = Path(value).expanduser()
        if not path.is_symlink():
            continue
        current = (path.parent / os.readlink(path)).resolve()
        if not repo.is_relative_to(current):
            continue
        disabled = path.with_name(path.name + DISABLED_SUFFIX)
        if not check:
            if disabled.exists() or disabled.is_symlink():
                raise BuildError(
                    f"cannot disable {path}: {disabled} already exists",
                    ExitCode.USAGE,
                    path=str(path),
                    target=str(current),
                )
            os.rename(path, disabled)
        rows.append(
            {
                "path": str(path),
                "action": "misdirected" if check else "disable",
                "target": str(current),
                "moved_to": str(disabled),
            }
        )
    return rows


def _link_line(row: dict) -> str:
    detail = row.get("target") or row.get("state", "")
    if "previous" in row:
        detail = f"{row['previous']} -> {row['target']}"
    if "moved_to" in row:
        detail = f"-> {row['target']} (covers this checkout); renamed {row['moved_to']}"
        if row["action"] == "misdirected":
            detail = f"-> {row['target']} (covers this checkout); would rename"
    return f"{row['action']}: {row['path']} {detail}".rstrip()


def build_parser():
    parser = argument_parser(
        prog="build-boot",
        description="Compile the protected harness boot for this instruction checkout. "
        "Contract: topics/helper-scripts.md § build-boot.",
        capabilities=CAPABILITIES,
        exit_codes=EXIT_CODES,
    )
    parser.add_argument(
        "--repo",
        default=str(_REPO_ROOT),
        help="Instruction checkout (default: the one containing this script).",
    )
    commands = parser.add_subparsers(dest="command", required=True)

    build_cmd = commands.add_parser(
        "build",
        help="Regenerate boot routes, AGENTS.boot.md, AGENTS.on-compact.md, and marked topic reread companions.",
    )
    build_cmd.add_argument(
        "--check",
        action="store_true",
        help="Write nothing; exit 3 when anything is stale.",
    )
    build_cmd.add_argument(
        "--index",
        action="store_true",
        help="Also regenerate the section inside the staged AGENTS.global.md (pre-commit hook use).",
    )
    build_cmd.add_argument(
        "--output", help="Boot file path (default: AGENTS.boot.md in the checkout)."
    )
    add_standard_args(build_cmd)
    build_cmd.set_defaults(func=build)

    link_cmd = commands.add_parser(
        "link",
        help="Point harness instruction symlinks that target the global policy or boot at the "
        f'boot file. Targets come from {CONFIG} (JSON {{"targets": [...]}}) or the standard '
        "harness paths; regular files and foreign links are reported and left alone. Also "
        f"renames (suffix {DISABLED_SUFFIX}) OpenCode agent/command/mode/plugin/skill/tool "
        "directory links that resolve to this checkout or an ancestor.",
    )
    link_cmd.add_argument(
        "--check",
        action="store_true",
        help="Change nothing; exit 3 when a link needs retargeting or disabling.",
    )
    link_cmd.add_argument(
        "--to-global",
        action="store_true",
        help="Retarget back to AGENTS.global.md (undo).",
    )
    add_standard_args(link_cmd)
    link_cmd.set_defaults(func=link)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    maybe_complete(parser, [sys.argv[0], *(argv if argv is not None else sys.argv[1:])])
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except BuildError as exc:
        die(str(exc), exc.code, detail=exc.detail or None)
    except subprocess.CalledProcessError as exc:
        die(
            f"git failed: {' '.join(exc.cmd)}",
            ExitCode.SOFTWARE,
            detail={"stderr": (exc.stderr or "").strip()},
        )


if __name__ == "__main__":
    sys.exit(main())
