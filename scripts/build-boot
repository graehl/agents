#!/usr/bin/env python3
"""Compile the harness boot file and the generated sections of AGENTS.global.md.

A harness protects only the one instruction file it loads, so an
effectively unconditional read belongs inside that file. `build`
regenerates the activity-route section of AGENTS.global.md from the
Governs rows of GLOSSARY.agents.md, then writes the git-excluded
AGENTS.boot.md: the global policy followed by AGENTS.user.md, which
stays out of the tracked global file. `link` points the harness
instruction symlinks at the boot file. Contract: topics/helper-scripts.md
§ build-boot.
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from urllib.parse import unquote, urlsplit

_REPO_ROOT = Path(__file__).resolve().parent.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from acli import (
    ExitCode,
    add_standard_args,
    argument_parser,
    die,
    emit,
    maybe_complete,
    resolve_format,
)

CAPABILITIES = ("complete",)
EXIT_CODES = {
    3: "check found a stale generated section, boot file, or link, or a misdirected "
    "OpenCode discovery link",
    4: "a source file or generated-section marker is missing",
}

GLOBAL = "AGENTS.global.md"
USER = "AGENTS.user.md"
GLOSSARY = "GLOSSARY.agents.md"
BOOT = "AGENTS.boot.md"
ON_COMPACT = "AGENTS.on-compact.md"
REREAD_BEGIN = "<!-- BEGIN generated: mandatory rereads (scripts/build-boot) -->"
REREAD_END = "<!-- END generated: mandatory rereads -->"
COMPACT_BEGIN = "<!-- BEGIN on-compact -->"
COMPACT_END = "<!-- END on-compact -->"
CONFIG = Path("~/.config/agents/build-boot.json")
BEGIN = "<!-- BEGIN generated: activity routes (scripts/build-boot) -->"
END = "<!-- END generated: activity routes -->"
USER_HEADING = "# User policy (compiled from AGENTS.user.md)"
HARNESSES = ("claude", "codex", "grok", "copilot")


def harness_boot(harness: str) -> str:
    return f"AGENTS.boot.{harness}.md"


def target_harness(path: Path) -> str | None:
    for harness in HARNESSES:
        if f".{harness}" in path.parts:
            return harness
    return None


# Harness instruction paths that may link to the global policy. The
# installer's table owns the canonical per-harness path; the extra entries
# are aliases some harness versions also read.
DEFAULT_TARGETS = (
    "~/.claude/CLAUDE.md",
    "~/.claude/AGENTS.md",
    "~/.codex/AGENTS.md",
    "~/.pi/agent/AGENTS.md",
    "~/.config/opencode/AGENTS.md",
    "~/.opencode/AGENTS.md",
    "~/.grok/AGENTS.md",
    "~/.copilot/copilot-instructions.md",
)

# OpenCode config-directory subtrees it globs for definitions at startup
# (`{agent,agents}/**/*.md`, `{plugin,plugins}/*.{ts,js}`, ...). A link
# from one to this checkout or an ancestor makes every matching repo file
# — vendored node_modules included — a definition, and OpenCode exits on
# the first that fails its schema. `link` disables such links.
DISCOVERY_DIRS = tuple(
    f"{root}/{name}"
    for root in ("~/.opencode", "~/.config/opencode")
    for kind in ("agent", "command", "mode", "plugin", "skill", "tool")
    for name in (kind, f"{kind}s")
)
DISABLED_SUFFIX = ".build-boot-disabled"


@dataclass(frozen=True)
class Group:
    key: str
    condition: str
    topics: tuple[str, ...]


# One shared condition per group; a Governs row joins the group naming its
# topic. A topic missing here lands in the final group and is reported, so
# a new topic is routed before anyone classifies it.
GROUPS = (
    Group(
        "documents",
        "**Documents for readers.** Before drafting or substantially revising a "
        "report, brief, estimate, proposal, handout, paper, blog post, or story, "
        "read `writing` and the genre topic it names. Working records (handoffs, "
        "gaps, logs, commit messages, instructions, code and its comments) do not "
        "trigger this. Immediate steer: answer the question as asked, in the "
        "asker's terms, first; use the reader's words, not the working vocabulary "
        "of this project or its instructions.",
        (
