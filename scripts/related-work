#!/usr/bin/env python3
# acli: 1 complete toon
"""related-work — fetch, audit, and report a field survey's related-work tree.

Contract: topics/research-survey.md in the ~/agents repo. Every field survey
under `surveys/<field>/` keeps a `related-work/` directory holding a committed
`papers.yaml` manifest plus committed full-text Markdown, provenance, and
referenced assets under `extract/`; raw source cache remains ignored. This tool
owns both, so a new survey inherits fetch idempotency, HTTP revalidation, and
manifest/disk reconciliation instead of hand-rolling a `fetch.sh`.

Verbs: list, status, fetch, audit, init.
Output follows topics/agent-cli.md: compact JSONL by default, --pretty for
humans, --toon on the table verbs, --acli-complete for completion.

Exit codes (beyond 0/2): 3 = audit found incomplete citation metadata or
extract drift, 4 = no such survey or key, 70 = papers.yaml is not the shape
this tool reads, 75 = a fetch or extraction failed.

Not almanac. `almanac` caches web pages as queryable *record datasets* under
its own cache root; this manages a bibliography whose product is readable full
text beside a committed, hand-edited manifest. Same verb names, different
artifact.
"""

from __future__ import annotations

import argparse
import hashlib
import html
import json
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from dataclasses import dataclass, field
from datetime import date, datetime, timezone
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import unquote, urljoin, urlsplit

_REPO_ROOT = Path(__file__).resolve().parent.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from acli import ExitCode, Format, die, emit, resolve_format, write_jsonl
from acli.args import (
    add_standard_args,
    argument_parser,
    hint,
    maybe_complete,
    set_completer,
)

try:
    import yaml
except ModuleNotFoundError:  # pragma: no cover - environment guard
    die(
        "PyYAML is required to read papers.yaml",
        ExitCode.UNAVAILABLE,
        detail={"install": "pip install pyyaml"},
    )

CAPABILITIES = ("complete", "toon")
EXIT_CODES = {
    3: "audit found incomplete citation metadata or extract drift",
    4: "no such survey directory or paper key",
    70: "papers.yaml is not the shape this tool reads",
    75: "a fetch or extraction failed",
}
USER_AGENT = "related-work/1 (+https://github.com/graehl/agents)"
SENTINEL = ".fetched"
SAFE_KEY = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
HTML_METHODS = frozenset(("arxiv-html", "url-html"))
LEGACY_HTML_METHODS = frozenset(("backfilled", "tcircuits-html"))
HTML2TEXT_VERSION = "2025.4.15"
HTML_DERIVATION = f"related-work html-md-v2 + html2text {HTML2TEXT_VERSION}"
HTML_FIDELITY = "visible-blocks-v1"
MIN_BLOCK_COVERAGE = 0.9
REQUIRED_CITATION_FIELDS = ("title", "authors", "venue", "year")


# --- manifest ---


@dataclass
class Paper:
    """One `papers.yaml` entry, with the fields this tool reasons about.

    `key` is the citation key and the only name the extract tree ever uses.
    `short` names a concept page and is assigned later, if ever — keying
    extracts on it would move every directory out from under its sentinel.
    """

    key: str
    ident: str | None
    kind: str | None  # "arxiv" | "url" | None
    grounded: bool
    verified: bool
    fetched: str | None
    source: str | None
    short: str | None
    concept_page: str | None
    raw: dict = field(repr=False, default_factory=dict)


@dataclass
class Survey:
    root: Path  # the related-work/ directory
    meta: dict
    papers: list[Paper]

    @property
    def manifest_path(self) -> Path:
        return self.root / "papers.yaml"

    @property
    def extract_root(self) -> Path:
        return self.root / "extract"

    def extract_dir(self, key: str) -> Path:
        return self.extract_root / key

    def sentinel_path(self, key: str) -> Path:
        return self.extract_dir(key) / SENTINEL

    def find(self, key: str) -> Paper:
        for paper in self.papers:
            if paper.key == key:
                return paper
        die(
            f"no paper with key {key!r} in {self.manifest_path}",
            ExitCode.NOT_FOUND,
            detail={"key": key},
        )


def _bool(value, default: bool = False) -> bool:
    return value if isinstance(value, bool) else default


def _text(value) -> str | None:
    """A YAML scalar as a string, or None when absent.

    YAML resolves a bare `2026-07-31` to a `datetime.date`, which every output
    path here has to serialize as JSON. Normalizing at the boundary keeps that
    from surfacing as an encoder crash three verbs away.
    """
    if value is None or value == "":
        return None
    return value.isoformat() if isinstance(value, (date, datetime)) else str(value)


def _citation_field_present(value) -> bool:
    if isinstance(value, list):
        return bool(value) and all((_text(item) or "").strip() for item in value)
    return bool((_text(value) or "").strip())


def _manifest_key(value, index: int) -> str:
    key = _text(value)
    if key is None or SAFE_KEY.fullmatch(key) is None:
        die(
            f"papers[{index}].key must be one safe path component",
            ExitCode.SOFTWARE,
            detail={"key": key},
        )
    return key


def _contained_manifest_path(root: Path, value, index: int) -> str | None:
    text = _text(value)
    if text is None:
        return None
    relative = Path(text)
    base = root.parent.resolve()
    candidate = (base / relative).resolve()
    try:
        candidate.relative_to(base)
    except ValueError:
        die(
            f"papers[{index}].concept_page must stay inside the survey",
            ExitCode.SOFTWARE,
            detail={"concept_page": text},
        )
    if relative.is_absolute():
        die(
            f"papers[{index}].concept_page must be survey-relative",
            ExitCode.SOFTWARE,
            detail={"concept_page": text},
        )
    return text


def load_survey(start: Path) -> Survey:
    """Resolve `start` to a related-work directory and parse its manifest.

    Accepts the directory itself, a survey root holding one, or the manifest
    path, so `related-work audit` works from wherever the agent happens to be.
    """
    candidates = [start, start / "related-work"]
    if start.name == "papers.yaml":
        candidates = [start.parent]
    root = next((c for c in candidates if (c / "papers.yaml").is_file()), None)
    if root is None:
        die(
            f"no papers.yaml under {start} or {start}/related-work",
            ExitCode.NOT_FOUND,
            detail={"searched": [str(c) for c in candidates]},
        )
    try:
        data = yaml.safe_load(root.joinpath("papers.yaml").read_text()) or {}
    except (OSError, yaml.YAMLError) as exc:
        die(f"cannot parse {root}/papers.yaml: {exc}", ExitCode.SOFTWARE)
    if not isinstance(data, dict) or not isinstance(data.get("papers"), list):
        die(
            "papers.yaml must be a mapping with a `papers:` list",
            ExitCode.SOFTWARE,
            detail={"path": str(root / "papers.yaml")},
        )
    papers = []
    for index, entry in enumerate(data["papers"]):
        if not isinstance(entry, dict) or not entry.get("key"):
            die(
                f"papers[{index}] has no `key`",
                ExitCode.SOFTWARE,
                detail={"entry": str(entry)[:120]},
            )
        arxiv, url = entry.get("arxiv"), entry.get("url")
        papers.append(
            Paper(
                key=_manifest_key(entry["key"], index),
                ident=str(arxiv) if arxiv else (str(url) if url else None),
                kind="arxiv" if arxiv else ("url" if url else None),
                grounded=_bool(entry.get("grounded")),
                verified=_bool(entry.get("verified")),
                fetched=_text(entry.get("fetched")),
                source=_text(entry.get("source")),
                short=_text(entry.get("short")),
                concept_page=_contained_manifest_path(
                    root, entry.get("concept_page"), index
                ),
                raw=entry,
            )
        )
    return Survey(root=root, meta=data.get("meta") or {}, papers=papers)


# --- completion sentinel ---


@dataclass
class Sentinel:
    """Proof that an extract completed, plus what it would take to revalidate.

    Written only on success, so a crashed extraction leaves no sentinel and the
    next run retries it. Guarding on this rather than on the directory existing
    is what keeps a cached failure from masquerading as done.
    """

    method: str
    source: str
    at: str | None = None
    etag: str | None = None
    last_modified: str | None = None
    markdown: str | None = None
    derived_with: str | None = None
    source_sha256: str | None = None
    markdown_sha256: str | None = None
    fidelity: str | None = None

    def to_json(self) -> str:
        body = {"method": self.method, "source": self.source, "at": self.at}
        if self.etag:
            body["etag"] = self.etag
        if self.last_modified:
            body["last_modified"] = self.last_modified
        if self.markdown:
            body["markdown"] = self.markdown
        if self.derived_with:
            body["derived_with"] = self.derived_with
        if self.source_sha256:
            body["source_sha256"] = self.source_sha256
        if self.markdown_sha256:
            body["markdown_sha256"] = self.markdown_sha256
        if self.fidelity:
            body["fidelity"] = self.fidelity
        return json.dumps(body, sort_keys=True) + "\n"


def read_sentinel(path: Path) -> Sentinel | None:
    """Parse a sentinel, tolerating the pre-JSON `method<TAB>source` form."""
    try:
        text = path.read_text().strip()
    except OSError:
        return None
    if not text:
        return None
    if text.startswith("{"):
        try:
            body = json.loads(text)
        except ValueError:
            return None
        return Sentinel(
            method=str(body.get("method", "")),
            source=str(body.get("source", "")),
            at=body.get("at"),
            etag=body.get("etag"),
            last_modified=body.get("last_modified"),
            markdown=_text(body.get("markdown")),
            derived_with=_text(body.get("derived_with")),
            source_sha256=_text(body.get("source_sha256")),
            markdown_sha256=_text(body.get("markdown_sha256")),
            fidelity=_text(body.get("fidelity")),
        )
    method, _, source = text.partition("\t")
    return Sentinel(method=method, source=source)


def write_sentinel(path: Path, sentinel: Sentinel) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(sentinel.to_json())


# --- fetching ---


def have(tool: str) -> bool:
    return shutil.which(tool) is not None


class HtmlDerivationError(RuntimeError):
    pass


class HtmlSourceNotFound(HtmlDerivationError):
    pass


@dataclass(frozen=True)
class HtmlDerivation:
    markdown: str
    html: str
    source_sha256: str
    markdown_sha256: str
    fidelity: str


class _MathPreprocessor(HTMLParser):
    """Replace MathML with collision-free tokens and inventory rich content."""

    _CONTENT_ROOTS = frozenset(("article", "main"))
    _PRESENTATION_TAGS = frozenset(
        (
            "audio",
            "button",
            "canvas",
            "embed",
            "form",
            "iframe",
            "input",
            "object",
            "script",
            "select",
            "textarea",
            "video",
        )
    )

    def __init__(
        self,
        placeholder_prefix: str,
        *,
        base_url: str | None = None,
        source_name: str | None = None,
    ):
        super().__init__(convert_charrefs=False)
        self.placeholder_prefix = placeholder_prefix
        self.base_url = base_url
        self.source_name = source_name
        self.output: list[str] = []
        self.content_output: list[str] = []
        self.replacements: list[tuple[str, str, bool]] = []
        self.content_replacements: list[tuple[str, str, bool]] = []
        self.math_depth = 0
        self.math_in_content = False
        self.annotation_depth: int | None = None
        self.annotation: list[str] = []
        self.math_alttext: str | None = None
        self.block_math = False
        self.content_roots: list[str] = []
        self.saw_content_root = False
        self.presentation: set[str] = set()
        self.content_presentation: set[str] = set()

    def _append(self, text: str, *, in_content: bool | None = None) -> None:
        self.output.append(text)
        is_content = bool(self.content_roots) if in_content is None else in_content
        if is_content:
            self.content_output.append(text)

    def _record_presentation(
        self, tag: str, attributes: list[tuple[str, str | None]]
    ) -> None:
        attrs = {name.lower(): (value or "").lower() for name, value in attributes}
        reasons = {
            "data URI"
            for name, value in attributes
            if name.lower() in ("data", "href", "poster", "src")
            and (value or "").lstrip().lower().startswith("data:")
        }
        if tag in self._PRESENTATION_TAGS:
            reasons.add(tag)
        elif tag == "svg" and not (
            attrs.get("role") == "presentation" or attrs.get("aria-hidden") == "true"
        ):
            reasons.add("svg")
        elif tag in ("td", "th") and any(
            attrs.get(name, "1") not in ("", "1") for name in ("colspan", "rowspan")
        ):
            reasons.add("spanning table")
        if reasons:
            self.presentation.update(reasons)
            if self.content_roots:
                self.content_presentation.update(reasons)

    def _start_tag(
        self,
        tag: str,
        attributes: list[tuple[str, str | None]],
        *,
        self_closing: bool = False,
    ) -> str:
        kept = []
        for name, value in attributes:
            lowered = name.lower()
            stripped = (value or "").lstrip()
            if lowered in (
                "data",
                "href",
                "poster",
                "src",
            ) and stripped.lower().startswith("data:"):
                continue
            if lowered == "href" and stripped.lower().startswith("javascript:"):
                continue
            if lowered == "href" and value and self.base_url:
                parsed = urlsplit(value)
                if value.startswith("#"):
                    value = self.base_url.split("#", 1)[0] + value
                elif (
                    not parsed.scheme
                    and not parsed.netloc
                    and Path(unquote(parsed.path)).suffix.lower() in (".htm", ".html")
                ):
                    if Path(unquote(parsed.path)).name == self.source_name:
                        value = self.base_url.split("#", 1)[0]
                        if parsed.fragment:
                            value += f"#{parsed.fragment}"
                    else:
                        value = urljoin(self.base_url, value)
            kept.append((name, value))
        rendered = [f"<{tag}"]
        for name, value in kept:
            rendered.append(
                f' {name}="{html.escape(value, quote=True)}"'
                if value is not None
                else f" {name}"
            )
        rendered.append(" />" if self_closing else ">")
        return "".join(rendered)

    def _missing_image(self, attributes: list[tuple[str, str | None]]) -> bool:
        attrs = {name.lower(): value or "" for name, value in attributes}
        return "ltx_missing_image" in attrs.get("class", "").split()

    def _missing_image_notice(self) -> str:
        target = self.base_url or ""
        parsed = urlsplit(target)
        if parsed.hostname == "arxiv.org" and parsed.path.startswith("/html/"):
            target = target.replace("/html/", "/pdf/", 1)
        label = "[Figure unavailable in source HTML; see source]"
        if not target:
            return label
        return f'<a href="{html.escape(target, quote=True)}">{label}</a>'

    def handle_starttag(
        self, tag: str, attributes: list[tuple[str, str | None]]
    ) -> None:
        tag = tag.lower()
        if self.math_depth:
            self.math_depth += 1
            attrs = {name.lower(): (value or "").lower() for name, value in attributes}
            if tag == "annotation" and attrs.get("encoding") == "application/x-tex":
                self.annotation_depth = self.math_depth
            return
        if tag == "math":
            attrs = {name.lower(): value or "" for name, value in attributes}
            self.math_depth = 1
            self.annotation_depth = None
            self.annotation = []
            self.math_alttext = attrs.get("alttext", "").strip() or None
            self.block_math = attrs.get("display", "").lower() == "block"
            self.math_in_content = bool(self.content_roots)
            return
        if tag == "img" and self._missing_image(attributes):
            self._append(self._missing_image_notice())
            return
        if tag in self._CONTENT_ROOTS:
            self.content_roots.append(tag)
            self.saw_content_root = True
        self._record_presentation(tag, attributes)
        self._append(self._start_tag(tag, attributes))

    def handle_startendtag(
        self, tag: str, attributes: list[tuple[str, str | None]]
    ) -> None:
        tag = tag.lower()
        if self.math_depth:
            return
        if tag == "math":
            raise HtmlDerivationError("a MathML element has no TeX annotation")
        if tag == "img" and self._missing_image(attributes):
            self._append(self._missing_image_notice())
            return
        self._record_presentation(tag, attributes)
        self._append(self._start_tag(tag, attributes, self_closing=True))

    def handle_endtag(self, tag: str) -> None:
        tag = tag.lower()
        if self.math_depth:
            if self.math_depth == 1:
                tex = "".join(self.annotation).strip() or self.math_alttext
                if tag != "math" or not tex:
                    raise HtmlDerivationError(
                        "a MathML element has neither an application/x-tex "
                        "annotation nor alttext"
                    )
                placeholder = (
                    f"{self.placeholder_prefix}{len(self.replacements):08d}END"
                )
                replacement = (placeholder, tex, self.block_math)
                self._append(placeholder, in_content=self.math_in_content)
                self.replacements.append(replacement)
                if self.math_in_content:
                    self.content_replacements.append(replacement)
                self.math_depth = 0
                self.annotation_depth = None
                self.math_alttext = None
                self.math_in_content = False
                return
            if self.annotation_depth == self.math_depth and tag == "annotation":
                self.annotation_depth = None
            self.math_depth -= 1
            return
        self._append(f"</{tag}>")
        if tag in self._CONTENT_ROOTS and tag in self.content_roots:
            index = len(self.content_roots) - 1 - self.content_roots[::-1].index(tag)
            del self.content_roots[index:]

    def handle_data(self, data: str) -> None:
        if self.annotation_depth is not None:
            self.annotation.append(data)
        elif not self.math_depth:
            self._append(data)

    def handle_entityref(self, name: str) -> None:
        reference = f"&{name};"
        if self.annotation_depth is not None:
            self.annotation.append(html.unescape(reference))
        elif not self.math_depth:
            self._append(reference)

    def handle_charref(self, name: str) -> None:
        reference = f"&#{name};"
        if self.annotation_depth is not None:
            self.annotation.append(html.unescape(reference))
        elif not self.math_depth:
            self._append(reference)

    def handle_comment(self, data: str) -> None:
        if not self.math_depth:
            self._append(f"<!--{data}-->")

    def handle_decl(self, decl: str) -> None:
        if not self.math_depth:
            self._append(f"<!{decl}>")

    def handle_pi(self, data: str) -> None:
        if not self.math_depth:
            self._append(f"<?{data}>")

    def unknown_decl(self, data: str) -> None:
        if not self.math_depth:
            self._append(f"<![{data}]>")

    def result(self) -> tuple[str, list[tuple[str, str, bool]], set[str]]:
        if self.math_depth:
            raise HtmlDerivationError("an unterminated MathML element was found")
        if self.saw_content_root:
            return (
                "".join(self.content_output),
                self.content_replacements,
                self.content_presentation,
            )
        return "".join(self.output), self.replacements, self.presentation


def preprocess_html(
    source: str,
    *,
    base_url: str | None = None,
    source_name: str | None = None,
) -> tuple[str, list[tuple[str, str, bool]], set[str]]:
    prefix = "RELATEDWORKMATHTOKEN"
    while prefix in source:
        prefix += "X"
    parser = _MathPreprocessor(prefix, base_url=base_url, source_name=source_name)
    parser.feed(source)
    parser.close()
    return parser.result()


_CONTENT_BLOCK_TAGS = frozenset(
    (
        "caption",
        "figcaption",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "p",
        "pre",
        "td",
        "th",
    )
)
_NONCONTENT_TAGS = frozenset(("head", "noscript", "script", "style", "template"))
_SEMANTIC_WORD = re.compile(r"RELATEDWORKMATHTOKEN[A-Z0-9]+|[^\W_]+", re.UNICODE)


def _semantic_words(text: str) -> tuple[str, ...]:
    return tuple(token.casefold() for token in _SEMANTIC_WORD.findall(text))


class _ContentBlockParser(HTMLParser):
    """Collect source-visible blocks for a conversion completeness check."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.skip_depth = 0
        self.stack: list[tuple[str, list[str]]] = []
        self.blocks: list[tuple[str, ...]] = []
        self.all_text: list[str] = []

    def handle_starttag(
        self, tag: str, attributes: list[tuple[str, str | None]]
    ) -> None:
        tag = tag.lower()
        if tag in _NONCONTENT_TAGS:
            self.skip_depth += 1
        if not self.skip_depth and tag == "br" and self.stack:
            self.stack[-1][1].append(" ")
        if not self.skip_depth and tag in _CONTENT_BLOCK_TAGS:
            self.stack.append((tag, []))

    def handle_endtag(self, tag: str) -> None:
        tag = tag.lower()
        if not self.skip_depth and tag in _CONTENT_BLOCK_TAGS:
            for index in range(len(self.stack) - 1, -1, -1):
                block_tag, parts = self.stack[index]
                if block_tag == tag:
                    del self.stack[index]
                    tokens = _semantic_words("".join(parts))
                    if tokens:
                        self.blocks.append(tokens)
                    break
        if tag in _NONCONTENT_TAGS and self.skip_depth:
            self.skip_depth -= 1

    def handle_data(self, data: str) -> None:
        if self.skip_depth:
            return
        self.all_text.append(data)
        if self.stack:
            self.stack[-1][1].append(data)


def _ngrams(tokens: tuple[str, ...], width: int) -> set[tuple[str, ...]]:
    return {tokens[index : index + width] for index in range(len(tokens) - width + 1)}


def _block_coverage(
    target: dict[int, set[tuple[str, ...]]], source: tuple[str, ...]
) -> float:
    width = min(5, len(source))
    expected = _ngrams(source, width)
    return len(expected & target[width]) / len(expected)


def _run_html2text(source: str, *options: str) -> str:
    completed = subprocess.run(
        [
            "uvx",
            "--from",
            f"html2text=={HTML2TEXT_VERSION}",
            "html2text",
            "--body-width=0",
            *options,
        ],
        input=source,
        capture_output=True,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        detail = completed.stderr.strip().splitlines()
        suffix = f": {detail[-1]}" if detail else ""
        raise HtmlDerivationError(
            f"html2text failed (exit {completed.returncode}){suffix}"
        )
    return completed.stdout


def _verify_visible_blocks(
    processed: str, replacements: list[tuple[str, str, bool]]
) -> str:
    prose_source = processed
    for placeholder, _tex, _block in replacements:
        prose_source = prose_source.replace(placeholder, " ")

    parser = _ContentBlockParser()
    parser.feed(prose_source)
    parser.close()
    blocks = [tokens for tokens in parser.blocks if len(tokens) >= 4]
    if not blocks:
        fallback = _semantic_words("".join(parser.all_text))
        if fallback:
            blocks = [fallback]
    if not blocks:
        raise HtmlDerivationError("source HTML has no auditable visible text block")

    target_words = _semantic_words(_run_html2text(prose_source, "--ignore-links"))
    target_ngrams = {width: _ngrams(target_words, width) for width in range(1, 6)}
    scores = [_block_coverage(target_ngrams, block) for block in blocks]
    failures = [
        (score, block)
        for score, block in zip(scores, blocks, strict=True)
        if score < MIN_BLOCK_COVERAGE
    ]
    if failures:
        score, block = min(failures)
        sample = " ".join(block[:16])
        raise HtmlDerivationError(
            f"visible-block fidelity failed for {len(failures)}/{len(blocks)} "
            f"blocks (minimum {score:.3f}; sample: {sample})"
        )
    return (
        f"{HTML_FIDELITY} blocks={len(blocks)}/{len(blocks)} "
        f"min={min(scores):.3f} math={len(replacements)}/{len(replacements)}"
    )


def _saved_html_path(directory: Path, url: str, stem: str) -> Path | None:
    path = Path(unquote(urlsplit(url).path).lstrip("/"))
    candidates: list[Path] = []
    if path.name:
        candidates.append(directory / path)
        if path.suffix.lower() not in (".htm", ".html"):
            candidates.append(directory / path.with_name(f"{path.name}.html"))
    else:
        candidates.append(directory / "index.html")
    candidates.append(directory / f"{stem}.html")
    for candidate in candidates:
        try:
            candidate.resolve().relative_to(directory.resolve())
        except ValueError:
            continue
        if candidate.is_file():
            return candidate

    expected_names = {candidate.name for candidate in candidates}
    named = [
        candidate
        for candidate in directory.rglob("*")
        if candidate.is_file() and candidate.name in expected_names
    ]
    if len(named) == 1:
        return named[0]
    pages = [
        candidate
        for candidate in directory.rglob("*")
        if candidate.is_file() and candidate.suffix.lower() in (".htm", ".html")
    ]
    return pages[0] if len(pages) == 1 else None


def _recorded_markdown_path(directory: Path, sentinel: Sentinel) -> Path | None:
    if not sentinel.markdown:
        return None
    relative = Path(sentinel.markdown)
    if relative.is_absolute() or relative.suffix.lower() != ".md":
        return None
    candidate = (directory / relative).resolve()
    try:
        candidate.relative_to(directory.resolve())
    except ValueError:
        return None
    return candidate


def _has_versioned_derivation(sentinel: Sentinel) -> bool:
    return sentinel.derived_with == HTML_DERIVATION


def _sha256_bytes(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def _sha256_file(path: Path) -> str:
    return _sha256_bytes(path.read_bytes())


def html_derivation_missing(directory: Path, sentinel: Sentinel) -> bool:
    if sentinel.method not in HTML_METHODS or _is_pdf_url(sentinel.source):
        return False
    markdown = _recorded_markdown_path(directory, sentinel)
    return (
        not _has_versioned_derivation(sentinel)
        or markdown is None
        or not markdown.is_file()
        or not sentinel.source_sha256
        or not sentinel.markdown_sha256
        or not (sentinel.fidelity or "").startswith(HTML_FIDELITY)
        or (
            markdown is not None
            and markdown.is_file()
            and _sha256_file(markdown) != sentinel.markdown_sha256
        )
    )


def derive_saved_html(directory: Path, url: str, stem: str) -> HtmlDerivation:
    source = _saved_html_path(directory, url, stem)
    if source is None:
        raise HtmlSourceNotFound("downloaded page has no unambiguous HTML entry point")
    if not have("uvx"):
        raise HtmlDerivationError("uvx is required for pinned html2text conversion")

    source_bytes = source.read_bytes()
    processed, replacements, presentation = preprocess_html(
        source_bytes.decode("utf-8"),
        base_url=url,
        source_name=source.name,
    )
    markdown = _run_html2text(processed)
    for placeholder, tex, block in replacements:
        if markdown.count(placeholder) != 1:
            raise HtmlDerivationError(
                f"html2text did not preserve math placeholder {placeholder} exactly once"
            )
        opening, closing = ("\\[", "\\]") if block else ("\\(", "\\)")
        markdown = markdown.replace(placeholder, f"{opening}{tex}{closing}")
    if not markdown.strip():
        raise HtmlDerivationError("html2text produced empty markdown")
    fidelity = _verify_visible_blocks(processed, replacements)

    target = source.with_suffix(".md")
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=target.parent,
            prefix=f".{target.name}.",
            delete=False,
        ) as output:
            temporary = Path(output.name)
            output.write(markdown)
        temporary.replace(target)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)

    relative = target.relative_to(directory).as_posix()
    detail = ", ".join(sorted(presentation))
    if presentation:
        disposition = f"kept (ignored source cache; {detail})"
    else:
        disposition = "kept (ignored source cache)"
    return HtmlDerivation(
        markdown=relative,
        html=disposition,
        source_sha256=_sha256_bytes(source_bytes),
        markdown_sha256=_sha256_bytes(markdown.encode("utf-8")),
        fidelity=fidelity,
    )


def http_headers(url: str) -> dict[str, str]:
    """Validators for `url`, or {} when the server offers none."""
    request = urllib.request.Request(
        url, method="HEAD", headers={"User-Agent": USER_AGENT}
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return {k.lower(): v for k, v in response.headers.items()}
    except (urllib.error.URLError, OSError, ValueError):
        return {}


def is_unchanged(url: str, sentinel: Sentinel) -> bool:
    """True when the server answers 304 to this sentinel's validators.

    Absent an ETag or Last-Modified there is nothing to ask, so the answer is
    False: "cannot tell" must read as "may have changed", never as fresh.
    """
    conditional = {"User-Agent": USER_AGENT}
    if sentinel.etag:
        conditional["If-None-Match"] = sentinel.etag
    if sentinel.last_modified:
        conditional["If-Modified-Since"] = sentinel.last_modified
    if len(conditional) == 1:
        return False
    request = urllib.request.Request(url, headers=conditional)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return response.status == 304
    except urllib.error.HTTPError as exc:
        return exc.code == 304
    except (urllib.error.URLError, OSError, ValueError):
        return False


def save_page(directory: Path, url: str, stem: str) -> bool:
    """Save `url` into `directory`, self-contained when wget is available.

    wget's page-requisites capture keeps figures readable offline; the urllib
    fallback saves the bare HTML, which the recorded source URL can always
    reconstitute into the richer form later.
    """
    directory.mkdir(parents=True, exist_ok=True)
    if have("wget"):
        # -p requisites, -k rewrite links for offline reading, -E fix
        # extensions, -nH drop the host dir, robots=off so figures come too.
        completed = subprocess.run(
            [
                "wget",
                "-q",
                "-e",
                "robots=off",
                "-p",
                "-k",
                "-E",
                "-nH",
                "--restrict-file-names=windows",
                "-P",
                str(directory),
                url,
            ],
            stdin=subprocess.DEVNULL,
            check=False,
        )
        if completed.returncode == 0:
            return True
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            (directory / f"{stem}.html").write_bytes(response.read())
        return True
    except (urllib.error.URLError, OSError, ValueError):
        return False


def download(url: str, target: Path) -> bool:
    target.parent.mkdir(parents=True, exist_ok=True)
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    temporary: Path | None = None
    try:
        with (
            urllib.request.urlopen(request, timeout=300) as response,
            tempfile.NamedTemporaryFile(
                dir=target.parent,
                prefix=f".{target.name}.",
                delete=False,
            ) as output,
        ):
            temporary = Path(output.name)
            shutil.copyfileobj(response, output)
        temporary.replace(target)
        return True
    except (urllib.error.URLError, OSError, ValueError):
        return False
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def _is_pdf_url(url: str) -> bool:
    """Recognize explicit PDF resources, including legacy `url-html` records."""
    return Path(unquote(urlsplit(url).path)).suffix.lower() == ".pdf"


def has_content(directory: Path) -> bool:
    """True when the directory holds extracted text, not just a raw download."""
    return any(directory.rglob("*.md"))


def _legacy_html_only(directory: Path, sentinel: Sentinel) -> bool:
    return (
        sentinel.method in LEGACY_HTML_METHODS
        and not has_content(directory)
        and any(
            path.is_file() and path.suffix.lower() in (".htm", ".html")
            for path in directory.rglob("*")
        )
    )


def _saved_html_source(directory: Path, paper: Paper, sentinel: Sentinel) -> str | None:
    candidates: list[str] = []
    parsed = urlsplit(sentinel.source)
    if parsed.scheme in ("http", "https") and not _is_pdf_url(sentinel.source):
        candidates.append(sentinel.source)
    if paper.kind == "arxiv" and paper.ident:
        candidates.append(f"https://arxiv.org/html/{paper.ident}")
    elif paper.kind == "url" and paper.ident and not _is_pdf_url(paper.ident):
        candidates.append(paper.ident)
    for source in dict.fromkeys(candidates):
        if _saved_html_path(directory, source, paper.key) is not None:
            return source
    return None


def _html_method(source: str) -> str:
    parsed = urlsplit(source)
    if parsed.hostname == "arxiv.org" and parsed.path.startswith("/html/"):
        return "arxiv-html"
    return "url-html"


SVG_FIGURES = _REPO_ROOT / "scripts" / "pdf-figures-svg"


def vector_figures_blocker() -> str | None:
    """Why the SVG figure pass cannot run here, or None when it can.

    Named for the negative because the caller has to *say* why it skipped:
    a figure pass that quietly no-ops leaves an extract that looks complete
    and has silently thrown away every vector figure's resolution.
    """
    if not SVG_FIGURES.exists():
        return f"missing {SVG_FIGURES.name}"
    if not have("uv"):
        return "uv not on PATH"
    return None


def vector_figures(pdf: Path, blocks: Path, markdown: Path) -> dict:
    """Recut this extract's figure crops as SVG; report the outcome counts."""
    completed = subprocess.run(
        [
            str(SVG_FIGURES),
            "--pdf",
            str(pdf),
            "--blocks",
            str(blocks),
            "--markdown",
            str(markdown),
            "--compact",
        ],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        check=False,
    )
    counts: dict[str, int] = {}
    for line in completed.stdout.splitlines():
        try:
            status = json.loads(line).get("status")
        except json.JSONDecodeError:
            continue
        if isinstance(status, str):
            counts[status] = counts.get(status, 0) + 1
    if not counts:
        return {"figures": f"no rows (exit {completed.returncode})"}
    return {
        "figures": ", ".join(f"{n} {status}" for status, n in sorted(counts.items()))
    }


def run_marker(
    pdf: Path, directory: Path, key: str, *, svg_figures: bool
) -> dict | None:
    """PDF -> markdown via marker_single, keeping its extracted images.

    Returns extraction notes for the result row, or None when nothing usable
    came out. A marker crash (CUDA OOM is the usual one) is tolerated and
    leaves the downloaded PDF in place, so the retry costs no bandwidth.

    marker fixes each figure's resolution when it crops the region to a
    raster image, so the same run also dumps per-block geometry and
    `pdf-figures-svg` recuts the vector ones from the PDF.
    """
    if not have("marker_single"):
        return None
    blocker = vector_figures_blocker() if svg_figures else "not requested"
    with tempfile.TemporaryDirectory(dir=directory.parent) as tmp:
        command = ["marker_single", str(pdf), "--output_dir", tmp]
        geometry = Path(tmp) / "geometry"
        if blocker is None:
            config = Path(tmp) / "marker-config.json"
            config.write_text(
                json.dumps({"debug_json": True, "debug_data_folder": str(geometry)})
            )
            command += ["--config_json", str(config)]
        subprocess.run(
            command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, check=False
        )
        produced = next(
            (p for p in Path(tmp).iterdir() if p.is_dir() and p != geometry), None
        )
        if produced is None:
            return None
        shutil.copytree(produced, directory, dirs_exist_ok=True)
        markdown = next(iter(sorted(directory.glob("*.md"))), None)
        if markdown is not None and markdown.name != f"{key}.md":
            markdown = markdown.rename(directory / f"{key}.md")
        blocks = next(iter(sorted(geometry.glob("*/blocks.json"))), None)
        notes: dict = {}
        if blocker is not None:
            notes["figures"] = f"raster only ({blocker})"
        elif markdown is None or blocks is None:
            notes["figures"] = "raster only (marker dumped no block geometry)"
        else:
            notes = vector_figures(pdf, blocks, markdown)
    return notes if has_content(directory) else None


def fetch_paper(
    survey: Survey,
    paper: Paper,
    *,
    no_html: bool,
    download_only: bool,
    svg_figures: bool,
    refresh_source: bool,
) -> dict:
    """Build one extract. Returns a JSONL-shaped result row."""
    directory = survey.extract_dir(paper.key)
    sentinel_path = survey.sentinel_path(paper.key)
    stamp = datetime.now(timezone.utc).date().isoformat()

    def done(
        method: str, source: str, derivation: HtmlDerivation | None = None
    ) -> dict:
        headers = http_headers(source)
        write_sentinel(
            sentinel_path,
            Sentinel(
                method=method,
                source=source,
                at=stamp,
                etag=headers.get("etag"),
                last_modified=headers.get("last-modified"),
                markdown=derivation.markdown if derivation else None,
                derived_with=HTML_DERIVATION if derivation else None,
                source_sha256=derivation.source_sha256 if derivation else None,
                markdown_sha256=derivation.markdown_sha256 if derivation else None,
                fidelity=derivation.fidelity if derivation else None,
            ),
        )
        row = {
            "key": paper.key,
            "status": "fetched",
            "method": method,
            "source": source,
        }
        if derivation is not None:
            row.update(
                markdown=derivation.markdown,
                html=derivation.html,
                fidelity=derivation.fidelity,
            )
        return row

    def derive(method: str, source: str) -> dict:
        try:
            derivation = derive_saved_html(directory, source, paper.key)
        except (HtmlDerivationError, OSError, UnicodeError) as exc:
            return {
                "key": paper.key,
                "status": "failed",
                "reason": f"HTML derivation failed: {exc}",
            }
        return done(method, source, derivation)

    def extract_pdf(source: str, pdf: Path) -> dict:
        if (refresh_source or not pdf.exists()) and not download(source, pdf):
            return {
                "key": paper.key,
                "status": "failed",
                "reason": "pdf download failed",
            }
        if download_only:
            return {
                "key": paper.key,
                "status": "downloaded",
                "note": "no sentinel; extract later",
            }
        notes = run_marker(pdf, directory, paper.key, svg_figures=svg_figures)
        if notes is not None:
            return {**done("pdf-marker", source), **notes}
        reason = (
            "marker_single not on PATH"
            if not have("marker_single")
            else "marker produced no markdown"
        )
        return {
            "key": paper.key,
            "status": "failed",
            "reason": reason,
            "kept": str(pdf),
        }

    if paper.kind == "url":
        if _is_pdf_url(paper.ident):
            name = Path(unquote(urlsplit(paper.ident).path)).name
            return extract_pdf(paper.ident, directory / name)
        if save_page(directory, paper.ident, paper.key):
            if download_only:
                return {
                    "key": paper.key,
                    "status": "downloaded",
                    "note": "no sentinel; extract later",
                }
            return derive("url-html", paper.ident)
        return {"key": paper.key, "status": "failed", "reason": "page fetch failed"}

    html_url = f"https://arxiv.org/html/{paper.ident}"
    if not no_html and save_page(directory, html_url, paper.key):
        if download_only:
            return {
                "key": paper.key,
                "status": "downloaded",
                "note": "no sentinel; extract later",
            }
        return derive("arxiv-html", html_url)

    pdf_url = f"https://arxiv.org/pdf/{paper.ident}"
    return extract_pdf(pdf_url, directory / "source.pdf")


# --- audit ---


_MARKDOWN_IMAGE = re.compile(r"!\[[^\]]*\]\(((?:\\.|[^)])+)\)")


def _local_markdown_assets(markdown: Path, extract_root: Path) -> list[Path]:
    assets = []
    for match in _MARKDOWN_IMAGE.finditer(markdown.read_text(errors="replace")):
        target = match.group(1).strip()
        if target.startswith("<") and ">" in target:
            target = target[1 : target.index(">")]
        else:
            target = re.split(r'\s+["\']', target, maxsplit=1)[0]
        parsed = urlsplit(target)
        if parsed.scheme or parsed.netloc or not parsed.path:
            continue
        candidate = (markdown.parent / unquote(parsed.path)).resolve()
        try:
            candidate.relative_to(extract_root.resolve())
        except ValueError:
            raise HtmlDerivationError(
                f"{markdown} references an asset outside extract/: {target}"
            )
        assets.append(candidate)
    return assets


def _git_tracked_extract_paths(survey: Survey) -> set[Path] | None:
    top = subprocess.run(
        ["git", "-C", str(survey.root), "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
    )
    if top.returncode != 0:
        return None
    repository = Path(top.stdout.strip()).resolve()
    relative = survey.extract_root.resolve().relative_to(repository)
    listed = subprocess.run(
        ["git", "-C", str(repository), "ls-files", "-z", "--", str(relative)],
        capture_output=True,
        check=True,
    )
    return {
        (repository / entry.decode()).resolve()
        for entry in listed.stdout.split(b"\0")
        if entry
    }


def audit_findings(survey: Survey) -> list[dict]:
    """Every incomplete citation or manifest/extract disagreement.

    The manifest header defines `grounded` as "source fetched" and `verified`
    as "citation checked against a fetched source", which makes most of it
    mechanically checkable. Doing that by hand is how it drifted: entries
    fetched but never marked, and entries marked but never fetched.
    """
    findings: list[dict] = []

    def report(key: str, rule: str, detail: str) -> None:
        findings.append({"key": key, "rule": rule, "detail": detail})

    tracked = _git_tracked_extract_paths(survey)
    seen: set[str] = set()
    for paper in survey.papers:
        if paper.key in seen:
            report(paper.key, "duplicate-key", "appears more than once in papers.yaml")
        seen.add(paper.key)

        missing_citation = [
            name
            for name in REQUIRED_CITATION_FIELDS
            if not _citation_field_present(paper.raw.get(name))
        ]
        if missing_citation:
            report(
                paper.key,
                "citation-metadata",
                "required citation fields are empty: " + ", ".join(missing_citation),
            )

        directory = survey.extract_dir(paper.key)
        sentinel_path = survey.sentinel_path(paper.key)
        sentinel = read_sentinel(sentinel_path)
        fetched = sentinel is not None
        if fetched:
            if not paper.grounded:
                report(
                    paper.key, "grounded", "extract fetched, but grounded is not true"
                )
            if not paper.fetched:
                report(
                    paper.key, "fetched-date", "extract fetched, but fetched: is empty"
                )
            if not paper.verified:
                # Its own full text is on disk; nothing is left to check.
                report(
                    paper.key,
                    "verified",
                    "own source fetched, but verified is not true",
                )
        elif paper.grounded:
            report(paper.key, "grounded", f"grounded: true, but no {SENTINEL}")

        if (
            sentinel is not None
            and sentinel.method in HTML_METHODS
            and not _is_pdf_url(sentinel.source)
        ):
            markdown = _recorded_markdown_path(directory, sentinel)
            if markdown is None:
                report(
                    paper.key,
                    "html-markdown",
                    "HTML extract sentinel records no safe markdown path",
                )
            elif not markdown.is_file():
                report(
                    paper.key,
                    "html-markdown",
                    f"derived markdown is missing: {sentinel.markdown}",
                )
            if not _has_versioned_derivation(sentinel):
                report(
                    paper.key,
                    "html-derivation",
                    "HTML extract sentinel does not match the current "
                    "derivation version",
                )
            if (
                not sentinel.source_sha256
                or not sentinel.markdown_sha256
                or not (sentinel.fidelity or "").startswith(HTML_FIDELITY)
            ):
                report(
                    paper.key,
                    "html-fidelity",
                    "HTML extract sentinel records no source/target hashes and "
                    "visible-block fidelity result",
                )
            elif (
                markdown is not None
                and markdown.is_file()
                and _sha256_file(markdown) != sentinel.markdown_sha256
            ):
                report(
                    paper.key,
                    "html-fidelity",
                    f"derived markdown hash does not match {sentinel.markdown_sha256}",
                )
        elif sentinel is not None and not has_content(directory):
            report(
                paper.key,
                "extract-content",
                "completed extract contains no Markdown",
            )

        if sentinel is not None and tracked is not None:
            if sentinel_path.resolve() not in tracked:
                report(
                    paper.key,
                    "authority-provenance",
                    f"{SENTINEL} is not tracked",
                )
            markdown_files = sorted(directory.rglob("*.md"))
            for markdown_file in markdown_files:
                if markdown_file.resolve() not in tracked:
                    report(
                        paper.key,
                        "authority-markdown",
                        f"{markdown_file.relative_to(directory)} is not tracked",
                    )
                try:
                    assets = _local_markdown_assets(markdown_file, survey.extract_root)
                except HtmlDerivationError as exc:
                    report(paper.key, "authority-asset", str(exc))
                    continue
                for asset in assets:
                    if asset.suffix.lower() in (".htm", ".html"):
                        report(
                            paper.key,
                            "authority-asset",
                            f"{asset.relative_to(directory)} is HTML, not a "
                            "committable figure",
                        )
                    elif not asset.is_file():
                        report(
                            paper.key,
                            "authority-asset",
                            f"{asset.relative_to(directory)} is missing",
                        )
                    elif asset not in tracked:
                        report(
                            paper.key,
                            "authority-asset",
                            f"{asset.relative_to(directory)} is not tracked",
                        )
            raw_tracked = sorted(
                path
                for path in tracked
                if path.is_relative_to(directory.resolve())
                and path.suffix.lower() in (".htm", ".html", ".pdf")
            )
            if raw_tracked:
                names = ", ".join(
                    str(path.relative_to(directory)) for path in raw_tracked[:3]
                )
                report(
                    paper.key,
                    "authority-source",
                    f"raw source is tracked instead of ignored: {names}",
                )

        if directory.is_dir() and paper.ident is None:
            report(
                paper.key,
                "regenerable",
                "extract on disk, but no arxiv:/url: to rebuild it",
            )
        if paper.verified and not paper.grounded and not paper.source:
            # Legal and common — a citation checked against the anchor's
            # bibliography needs no extract — but it must say where.
            report(
                paper.key, "source", "verified without its own extract needs source:"
            )
        if (
            paper.concept_page
            and not (survey.root.parent / paper.concept_page).is_file()
        ):
            report(paper.key, "concept-page", f"{paper.concept_page} does not exist")

    known = {paper.key for paper in survey.papers}
    if survey.extract_root.is_dir():
        for directory in sorted(survey.extract_root.iterdir()):
            if directory.is_dir() and directory.name not in known:
                report(
                    directory.name,
                    "orphan-extract",
                    "no papers.yaml entry claims this extract",
                )
    return findings


def survey_status(survey: Survey) -> dict:
    concepts = survey.root.parent / "concepts"
    digests = len(list(concepts.glob("*.md"))) if concepts.is_dir() else 0
    return {
        "survey": str(survey.root.parent.name),
        "manifested": len(survey.papers),
        "verified": sum(1 for p in survey.papers if p.verified),
        "grounded": sum(1 for p in survey.papers if p.grounded),
        "extracts": sum(
            1 for p in survey.papers if survey.sentinel_path(p.key).exists()
        ),
        "digested": digests,
        "coverage_cutoff": _text(survey.meta.get("coverage_cutoff")),
        "grounding_mode": _text(survey.meta.get("grounding_mode")),
    }


# --- verbs ---


def resolve(args) -> Survey:
    return load_survey(Path(args.dir).resolve())


def emit_table(args, rows: list[dict], columns: list[str], name: str) -> None:
    fmt = resolve_format(args)
    if fmt is Format.TOON:
        # A TOON table is uniform by contract, while these rows carry only the
        # keys their own outcome produced (a failure has `reason`, not
        # `method`). Project each onto the declared columns.
        table = [{column: row.get(column, "") for column in columns} for row in rows]
        emit({"rows": table, "columns": columns, "name": name}, fmt)
    elif not rows and fmt is Format.COMPACT:
        # Definitive empty state (topics/agent-cli.md): zero lines is ambiguous.
        write_jsonl({"count": 0, "of": name})
    else:
        emit(rows, fmt)


def verb_list(args) -> int:
    survey = resolve(args)
    rows = [
        {
            "key": p.key,
            "short": p.short or "",
            "kind": p.kind or "",
            "grounded": p.grounded,
            "verified": p.verified,
            "extract": survey.sentinel_path(p.key).exists(),
        }
        for p in survey.papers
    ]
    emit_table(
        args,
        rows,
        ["key", "short", "kind", "grounded", "verified", "extract"],
        "papers",
    )
    return 0


def verb_status(args) -> int:
    emit(survey_status(resolve(args)), resolve_format(args))
    return 0


def verb_audit(args) -> int:
    survey = resolve(args)
    findings = audit_findings(survey)
    if not findings:
        emit({"ok": True, "drift": 0, **survey_status(survey)}, resolve_format(args))
        return 0
    emit_table(args, findings, ["key", "rule", "detail"], "findings")
    return int(ExitCode.DATA)


def verb_fetch(args) -> int:
    survey = resolve(args)
    if args.derive_only and (
        args.refetch or args.revalidate or args.download_only or args.no_html
    ):
        die(
            "--derive-only cannot be combined with --refetch, --revalidate, "
            "--download-only, or --no-html",
            ExitCode.USAGE,
        )
    if args.keys:
        wanted = [survey.find(key) for key in args.keys]
    else:
        if args.derive_only or args.revalidate or args.refetch:
            wanted = [p for p in survey.papers if p.ident]
        else:
            wanted = [
                p
                for p in survey.papers
                if p.ident and not survey.sentinel_path(p.key).exists()
            ]
        if not args.all and args.limit is None:
            # The bare form used to queue every unfetched paper at once, which
            # is a surprising amount of network for a command that reads like
            # a no-op. Make the size of the job something the caller states.
            die(
                f"{len(wanted)} papers have no extract; pass keys, --limit N, or --all",
                ExitCode.USAGE,
                detail={"pending": [p.key for p in wanted]},
            )
        if args.limit is not None:
            wanted = wanted[: args.limit]
    results = []
    failed = False
    for paper in wanted:
        if paper.ident is None:
            results.append(
                {"key": paper.key, "status": "skipped", "reason": "no arxiv:/url:"}
            )
            continue
        sentinel = read_sentinel(survey.sentinel_path(paper.key))
        if args.derive_only and sentinel is None:
            results.append(
                {
                    "key": paper.key,
                    "status": "skipped",
                    "reason": "no completed extract",
                }
            )
            continue
        if sentinel is not None and not args.refetch:
            if not args.revalidate and not args.derive_only:
                results.append(
                    {"key": paper.key, "status": "skipped", "reason": "already fetched"}
                )
                continue
            derived = None
            directory = survey.extract_dir(paper.key)
            if html_derivation_missing(directory, sentinel) or _legacy_html_only(
                directory, sentinel
            ):
                source = _saved_html_source(directory, paper, sentinel)
                try:
                    if source is None:
                        raise HtmlSourceNotFound(
                            "downloaded page has no unambiguous HTML entry point"
                        )
                    derivation = derive_saved_html(directory, source, paper.key)
                except HtmlSourceNotFound as exc:
                    if args.derive_only:
                        results.append(
                            {
                                "key": paper.key,
                                "status": "failed",
                                "reason": f"HTML derivation failed: {exc}",
                            }
                        )
                        failed = True
                        continue
                except (HtmlDerivationError, OSError, UnicodeError) as exc:
                    results.append(
                        {
                            "key": paper.key,
                            "status": "failed",
                            "reason": f"HTML derivation failed: {exc}",
                        }
                    )
                    failed = True
                    continue
                else:
                    sentinel.method = _html_method(source)
                    sentinel.source = source
                    sentinel.markdown = derivation.markdown
                    sentinel.derived_with = HTML_DERIVATION
                    sentinel.source_sha256 = derivation.source_sha256
                    sentinel.markdown_sha256 = derivation.markdown_sha256
                    sentinel.fidelity = derivation.fidelity
                    write_sentinel(survey.sentinel_path(paper.key), sentinel)
                    derived = {
                        "key": paper.key,
                        "status": "derived",
                        "method": sentinel.method,
                        "source": sentinel.source,
                        "markdown": derivation.markdown,
                        "html": derivation.html,
                        "fidelity": derivation.fidelity,
                    }
                    if args.derive_only:
                        results.append(derived)
                        continue
            if args.derive_only:
                results.append(
                    {
                        "key": paper.key,
                        "status": "skipped",
                        "reason": "no local HTML derivation needed",
                    }
                )
                continue
            if is_unchanged(sentinel.source, sentinel) and not html_derivation_missing(
                directory, sentinel
            ):
                results.append(
                    derived
                    or {
                        "key": paper.key,
                        "status": "fresh",
                        "source": sentinel.source,
                    }
                )
                continue
        results.append(
            fetch_paper(
                survey,
                paper,
                no_html=args.no_html,
                download_only=args.download_only,
                svg_figures=not args.no_svg_figures,
                refresh_source=args.refetch or sentinel is not None,
            )
        )
        failed = failed or results[-1]["status"] == "failed"
    emit_table(
        args,
        results,
        [
            "key",
            "status",
            "method",
            "reason",
            "markdown",
            "html",
            "fidelity",
            "figures",
        ],
        "results",
    )
    return int(ExitCode.TEMPORARY) if failed else 0


MANIFEST_TEMPLATE = """\
# Metadata manifest for surveys/{slug}.
#
# One entry per paper the field map references. `verified: true` means the
# citation was checked against a fetched source THIS repo can regenerate;
# `verified: false` means it is pretrained-recall reconstruction and the
# arxiv/venue/year/authors must be confirmed on a grounded pass. Do not cite
# a verified:false entry as authoritative.
#
# Fields: key, title, authors, venue, year, arxiv/url, grounded (source
# fetched?), verified (citation checked?), source (where a verified but
# ungrounded citation was checked), fetched (date or null), short + concept_page
# (once the paper earns a digest), cluster (survey.md section).
#
# Extracts are keyed by `key`, never by `short`: a short handle is assigned
# later, and rekeying would orphan every extract a concept page cites.
# Build and check them with `related-work fetch` / `related-work audit`.

meta:
  field_slug: {slug}
  coverage_cutoff: null
  grounding_mode: recall

papers: []
"""


def verb_init(args) -> int:
    root = Path(args.dir).resolve()
    if root.name != "related-work":
        root = root / "related-work"
    manifest = root / "papers.yaml"
    if manifest.exists():
        die(
            f"{manifest} already exists",
            ExitCode.CONFLICT,
            detail={"path": str(manifest)},
        )
    root.mkdir(parents=True, exist_ok=True)
    slug = args.slug or root.parent.name
    manifest.write_text(MANIFEST_TEMPLATE.format(slug=slug))
    gitignore = root / ".gitignore"
    if not gitignore.exists():
        gitignore.write_text(
            "# Commit fetched Markdown + provenance; ignore rebuildable sources/cache.\n"
            "extract/**\n"
            "!extract/**/\n"
            "!extract/**/*.md\n"
            "!extract/**/.fetched\n"
        )
    emit(
        {"status": "created", "manifest": str(manifest), "field_slug": slug},
        resolve_format(args),
    )
    return 0


# --- parser ---


def key_completer(survey_dir: str):
    def complete_key(prefix: str, tokens: list[str]):
        try:
            survey = load_survey(Path(survey_dir).resolve())
        except SystemExit:
            return [hint("no papers.yaml here; pass --dir")]
        return [p.key for p in survey.papers if p.key.startswith(prefix)]

    return complete_key


def nonnegative_int(value: str) -> int:
    parsed = int(value)
    if parsed < 0:
        raise argparse.ArgumentTypeError("must be nonnegative")
    return parsed


def build_parser():
    parser = argument_parser(
        prog="related-work",
        description="Fetch and audit a field survey's related-work tree. "
        "Contract: topics/research-survey.md.",
        capabilities=CAPABILITIES,
        exit_codes=EXIT_CODES,
    )
    parser.add_argument(
        "--dir",
        default=".",
        help="Survey or related-work directory (default: cwd, then ./related-work).",
    )
    sub = parser.add_subparsers(dest="verb", required=True)

    p = sub.add_parser("list", help="One row per manifested paper.")
    add_standard_args(p, allow_toon=True)
    p.set_defaults(func=verb_list)

    p = sub.add_parser(
        "status", help="Derived counts for the survey's grounding banner."
    )
    add_standard_args(p)
    p.set_defaults(func=verb_status)

    p = sub.add_parser(
        "audit",
        help="Validate citation metadata and reconcile extract/; exit 3 on drift.",
    )
    add_standard_args(p, allow_toon=True)
    p.set_defaults(func=verb_audit)

    p = sub.add_parser("fetch", help="Build extracts for papers that have none.")
    keys = p.add_argument(
        "keys", nargs="*", help="Citation keys; default is the pending set."
    )
    set_completer(keys, key_completer("."))
    p.add_argument("--all", action="store_true", help="Fetch every pending paper.")
    p.add_argument(
        "--limit", type=nonnegative_int, help="Fetch at most N pending papers."
    )
    p.add_argument(
        "--refetch", action="store_true", help="Rebuild even a completed extract."
    )
    p.add_argument(
        "--revalidate",
        action="store_true",
        help="Ask the server whether a completed extract is stale (ETag/Last-Modified) and rebuild if so.",
    )
    p.add_argument(
        "--derive-only",
        action="store_true",
        help="Derive missing Markdown from saved HTML without network access.",
    )
    p.add_argument(
        "--no-html",
        action="store_true",
        help="Skip the arXiv HTML view; go straight to PDF.",
    )
    p.add_argument(
        "--download-only",
        action="store_true",
        help="Download sources only; extract on a later run.",
    )
    p.add_argument(
        "--keys-only",
        dest="download_only",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    p.add_argument(
        "--no-svg-figures",
        action="store_true",
        help="Keep marker's fixed-resolution raster figure crops; skip the pdf-figures-svg recut.",
    )
    add_standard_args(p, allow_toon=True)
    p.set_defaults(func=verb_fetch)

    p = sub.add_parser("init", help="Scaffold a related-work/ for a new survey.")
    p.add_argument("--slug", help="Field slug (default: the parent directory name).")
    add_standard_args(p)
    p.set_defaults(func=verb_init)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    maybe_complete(parser, [sys.argv[0], *(argv if argv is not None else sys.argv[1:])])
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
