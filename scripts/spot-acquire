#!/usr/bin/env python3
"""spot-acquire: acquire N AWS Spot instances across priced pools, then exit.

Each pool is an Availability Zone (or a whole region) with its own price
cap. Every round, the tool reads the live Spot price of each configured
pool, tries the cheapest pools at or under their caps in order, and stops
as soon as COUNT instances have launched. Each launch is emitted as one
JSONL record the moment it is running, so a caller can start setup on it
while the tool keeps acquiring the rest.

Launch parameters per region (image, subnets per zone, security groups,
user data, root size, tags) come from a JSON config file:

    {"us-west-2": {"ami": "ami-...", "security_groups": ["sg-..."],
                   "subnets": {"us-west-2a": "subnet-...", "us-west-2b": "subnet-..."},
                   "user_data": "path/to/cloud-init.yaml", "root_gb": 100,
                   "key_name": null, "tags": {"purpose": "..."}}}

Relative `user_data` paths resolve against the config file's directory.

Acquisition is sequential and gated on the count, so it never launches
more than COUNT. `--on-acquire` runs a setup command per instance in the
background; its outcome is a separate record and never changes the count.
A run that fails setup is still an acquired, billing instance: the caller
decides whether to retry setup or terminate it.

Launches use one-time Spot requests with MaxPrice set to the pool's cap, so
AWS itself refuses a price above the cap. Client tokens make each
(pool, round) launch idempotent, so a lost response cannot double-launch.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

AGENTS_ROOT = Path(os.environ.get("AGENTS_DIR", Path.home() / "agents"))
if str(AGENTS_ROOT) not in sys.path:
    sys.path.insert(0, str(AGENTS_ROOT))

import acli  # noqa: E402
from acli.args import duration_seconds  # noqa: E402

CAPABILITIES = ()
EXIT_CODES = {
    0: "COUNT instances acquired (setup records report their own status)",
    2: "usage or configuration error",
    69: "deadline reached with fewer than COUNT instances (acquired ones stay running)",
    70: "unexpected AWS error on every remaining pool",
}
# Errors that mean "no capacity or price right now"; anything else drops the pool.
RETRYABLE = (
    "InsufficientInstanceCapacity",
    "InsufficientCapacity",
    "SpotMaxPriceTooLow",
    "MaxSpotInstanceCountExceeded",
    "Unsupported",
    "capacity-not-available",
    "no Spot capacity",
)
ZONE_RE = re.compile(r"^([a-z]{2}(?:-[a-z]+)+-\d+)([a-z])$")


@dataclass
class Pool:
    region: str
    zone: str
    subnet: str
    cap: float


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def aws(region: str, *args: str) -> tuple[int, str, str]:
    proc = subprocess.run(
        ["aws", "--region", region, "--output", "json", *args],
        capture_output=True,
        text=True,
        check=False,
    )
    return proc.returncode, proc.stdout, proc.stderr


def load_config(path: Path) -> dict:
    try:
        config = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        acli.die(f"cannot read config {path}: {exc}", acli.ExitCode.USAGE)
    for region, entry in config.items():
        for key in ("ami", "security_groups", "subnets"):
            if key not in entry:
                acli.die(f"config region {region} lacks {key!r}", acli.ExitCode.USAGE)
        if entry.get("user_data"):
            user_data = Path(entry["user_data"])
            entry["user_data"] = str(
                user_data if user_data.is_absolute() else path.parent / user_data
            )
            if not Path(entry["user_data"]).is_file():
                acli.die(
                    f"user data not found: {entry['user_data']}", acli.ExitCode.USAGE
                )
    return config


def parse_pools(specs: list[str], config: dict) -> list[Pool]:
    pools = []
    for spec in specs:
        target, sep, cap_text = spec.partition("=")
        try:
            cap = float(cap_text)
        except ValueError:
            cap = -1.0
        if not sep or cap <= 0:
            acli.die(
                f"--pool wants ZONE=MAXPRICE or REGION=MAXPRICE, got {spec!r}",
                acli.ExitCode.USAGE,
            )
        match = ZONE_RE.match(target)
        region = match.group(1) if match else target
        if region not in config:
            acli.die(
                f"--pool {spec}: region {region} is not in the config",
                acli.ExitCode.USAGE,
            )
        subnets = config[region]["subnets"]
        zones = [target] if match else sorted(subnets)
        for zone in zones:
            if zone not in subnets:
                acli.die(
                    f"--pool {spec}: no subnet configured for {zone}",
                    acli.ExitCode.USAGE,
                )
            pools.append(Pool(region, zone, subnets[zone], cap))
    return pools


def spot_prices(instance_type: str, regions: set[str]) -> dict[str, float]:
    prices: dict[str, float] = {}
    for region in regions:
        status, out, _ = aws(
            region,
            "ec2",
            "describe-spot-price-history",
            "--instance-types",
            instance_type,
            "--product-descriptions",
            "Linux/UNIX",
            "--start-time",
            now(),
        )
        if status != 0:
            continue
        for row in json.loads(out or "{}").get("SpotPriceHistory", []):
            # Rows come newest first; the first per zone is the live price.
            prices.setdefault(row["AvailabilityZone"], float(row["SpotPrice"]))
    return prices


def launch(pool: Pool, entry: dict, args, round_no: int) -> tuple[str, dict | str]:
    """Returns ("ok", instance), ("retry", message) or ("fatal", message)."""
    market = {
        "MarketType": "spot",
        "SpotOptions": {
            "SpotInstanceType": "one-time",
            "InstanceInterruptionBehavior": "terminate",
            "MaxPrice": f"{pool.cap:.4f}",
        },
    }
    tags = {"owner": args.owner, **entry.get("tags", {}), **dict(args.tag)}
    tag_list = ",".join(f"{{Key={k},Value={v}}}" for k, v in tags.items())
    cmd = [
        "ec2",
        "run-instances",
        "--image-id",
        entry["ami"],
        "--instance-type",
        args.instance_type,
        "--client-token",
        f"{args.token_prefix}-{pool.zone}-r{round_no}"[:64],
        "--instance-market-options",
        json.dumps(market),
        "--subnet-id",
        pool.subnet,
        "--security-group-ids",
        *entry["security_groups"],
        "--block-device-mappings",
        json.dumps(
            [
                {
                    "DeviceName": "/dev/sda1",
                    "Ebs": {
                        "VolumeSize": entry.get("root_gb", 100),
                        "VolumeType": "gp3",
                        "DeleteOnTermination": True,
                    },
                }
            ]
        ),
        "--metadata-options",
        "HttpTokens=required",
        "--tag-specifications",
        f"ResourceType=instance,Tags=[{tag_list}]",
        f"ResourceType=volume,Tags=[{tag_list}]",
        "--count",
        "1",
    ]
    if entry.get("user_data"):
        cmd += ["--user-data", f"file://{entry['user_data']}"]
    if entry.get("key_name"):
        cmd += ["--key-name", entry["key_name"]]
    if args.dry_run:
        cmd.append("--dry-run")
    status, out, err = aws(pool.region, *cmd)
    if args.dry_run:
        return (
            ("ok", {"dry_run": True})
            if "DryRunOperation" in err
            else ("fatal", err.strip()[-400:])
        )
    if status == 0:
        return "ok", json.loads(out)["Instances"][0]
    message = err.strip()[-400:]
    return (
        "retry" if any(token in message for token in RETRYABLE) else "fatal"
    ), message


def describe_running(pool: Pool, instance_id: str, timeout_s: float) -> dict:
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        status, out, _ = aws(
            pool.region, "ec2", "describe-instances", "--instance-ids", instance_id
        )
        if status == 0:
            instance = json.loads(out)["Reservations"][0]["Instances"][0]
            if instance["State"]["Name"] in ("running", "terminated", "shutting-down"):
                return instance
        time.sleep(10)
    return {"State": {"Name": "pending (wait timed out)"}}


def main() -> None:
    parser = acli.argument_parser(
        prog="spot-acquire",
        description=(
            "Acquire COUNT AWS Spot instances from priced pools; one JSONL record per acquisition, "
            "streamed as each instance is running. Blocks until COUNT is reached or --deadline passes."
        ),
        capabilities=CAPABILITIES,
        exit_codes=EXIT_CODES,
    )
    parser.add_argument(
        "--config",
        type=Path,
        required=True,
        help="JSON launch config per region (see module doc).",
    )
    parser.add_argument(
        "--pool",
        action="append",
        required=True,
        metavar="ZONE=MAXPRICE",
        help="Pool and its USD/hour cap, e.g. us-west-2b=2.00; REGION=MAXPRICE covers every configured zone.",
    )
    parser.add_argument(
        "--count", type=int, default=1, help="Instances to acquire (default 1)."
    )
    parser.add_argument("--instance-type", default="g7e.2xlarge")
    parser.add_argument(
        "--interval",
        type=duration_seconds,
        default=300.0,
        help="Pause between rounds (default 5m).",
    )
    parser.add_argument(
        "--deadline",
        type=duration_seconds,
        default=7200.0,
        help="Give up after this long (default 2h).",
    )
    parser.add_argument(
        "--token-prefix",
        default=None,
        help="Client-token prefix; reuse it to make a rerun idempotent.",
    )
    parser.add_argument(
        "--owner",
        default=os.environ.get("USER", "unknown"),
        help="owner tag (default $USER).",
    )
    parser.add_argument(
        "--tag",
        action="append",
        default=[],
        type=lambda s: tuple(s.split("=", 1)),
        metavar="KEY=VALUE",
    )
    parser.add_argument(
        "--on-acquire",
        metavar="CMD",
        help="Shell command run in the background per instance with SPOT_INSTANCE_ID, SPOT_REGION, SPOT_ZONE, "
        "SPOT_PRIVATE_IP and SPOT_PUBLIC_IP set; its output goes to --log-dir.",
    )
    parser.add_argument(
        "--log-dir",
        type=Path,
        default=Path("."),
        help="Attempt log and setup logs (default .).",
    )
    parser.add_argument(
        "--no-wait",
        action="store_true",
        help="Emit on launch instead of waiting for running.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate each pool with run-instances --dry-run.",
    )
    acli.add_standard_args(parser)
    acli.maybe_complete(parser)
    args = parser.parse_args()
    try:
        fmt = acli.resolve_format(args)
    except ValueError as exc:
        acli.die(str(exc), acli.ExitCode.USAGE)
    if args.count < 1:
        acli.die("--count must be at least 1", acli.ExitCode.USAGE)
    if any(len(t) != 2 for t in args.tag):
        acli.die("--tag wants KEY=VALUE", acli.ExitCode.USAGE)
    config = load_config(args.config)
    pools = parse_pools(args.pool, config)
    args.token_prefix = (
        args.token_prefix or f"spot-acquire-{datetime.now(timezone.utc):%Y%m%dT%H%M%S}"
    )
    args.log_dir.mkdir(parents=True, exist_ok=True)
    attempts = (args.log_dir / "spot-acquire-attempts.jsonl").open("a")

    def record(value: dict) -> None:
        acli.emit(value, fmt)
        sys.stdout.flush()

    acquired: list[dict] = []
    setups: list[tuple[dict, subprocess.Popen, Path]] = []
    started = time.monotonic()
    round_no = 0
    while len(acquired) < args.count and pools:
        round_no += 1
        prices = spot_prices(args.instance_type, {p.region for p in pools})
        ranked = sorted(pools, key=lambda p: prices.get(p.zone, float("inf")))
        for pool in ranked:
            if len(acquired) >= args.count:
                break
            quote = prices.get(pool.zone)
            if quote is None or quote > pool.cap:
                outcome, detail = (
                    "skip",
                    f"quote {quote} above cap {pool.cap}" if quote else "no quote",
                )
            else:
                outcome, detail = launch(pool, config[pool.region], args, round_no)
            attempts.write(
                json.dumps(
                    {
                        "time": now(),
                        "round": round_no,
                        "zone": pool.zone,
                        "quote": quote,
                        "cap": pool.cap,
                        "outcome": outcome,
                        "detail": detail
                        if isinstance(detail, str)
                        else detail.get("InstanceId"),
                    }
                )
                + "\n"
            )
            attempts.flush()
            if outcome == "fatal":
                pools.remove(pool)
                record({"event": "pool_dropped", "zone": pool.zone, "error": detail})
            if outcome != "ok":
                continue
            if args.dry_run:
                record(
                    {
                        "event": "dry_run_ok",
                        "zone": pool.zone,
                        "quote": quote,
                        "cap": pool.cap,
                    }
                )
                pools.remove(pool)
                continue
            instance = detail
            if not args.no_wait:
                instance = {
                    **instance,
                    **describe_running(pool, instance["InstanceId"], 600),
                }
            item = {
                "event": "acquired",
                "instance_id": instance["InstanceId"],
                "region": pool.region,
                "zone": pool.zone,
                "instance_type": args.instance_type,
                "quote_usd_hr": quote,
                "cap_usd_hr": pool.cap,
                "state": instance["State"]["Name"],
                "private_ip": instance.get("PrivateIpAddress"),
                "public_ip": instance.get("PublicIpAddress"),
                "acquired_at": now(),
                "index": len(acquired) + 1,
                "count": args.count,
            }
            acquired.append(item)
            record(item)
            if args.on_acquire:
                log = args.log_dir / f"setup-{item['instance_id']}.log"
                env = {
                    **os.environ,
                    "SPOT_INSTANCE_ID": item["instance_id"],
                    "SPOT_REGION": item["region"],
                    "SPOT_ZONE": item["zone"],
                    "SPOT_PRIVATE_IP": item["private_ip"] or "",
                    "SPOT_PUBLIC_IP": item["public_ip"] or "",
                }
                with log.open("w") as handle:
                    proc = subprocess.Popen(
                        ["bash", "-c", args.on_acquire],
                        env=env,
                        stdout=handle,
                        stderr=subprocess.STDOUT,
                    )
                setups.append((item, proc, log))
        if args.dry_run or len(acquired) >= args.count or not pools:
            break
        if time.monotonic() - started + args.interval > args.deadline:
            break
        time.sleep(args.interval)
    for item, proc, log in setups:
        code = proc.wait()
        record(
            {
                "event": "setup",
                "instance_id": item["instance_id"],
                "exit_code": code,
                "log": str(log),
            }
        )
    summary = {
        "event": "done",
        "acquired": len(acquired),
        "count": args.count,
        "rounds": round_no,
    }
    record(summary)
    if args.dry_run or len(acquired) >= args.count:
        return
    if not pools:
        acli.die(
            "every pool failed with a non-capacity error",
            acli.ExitCode.SOFTWARE,
            detail=summary,
        )
    acli.die(
        "deadline reached before COUNT instances were acquired",
        acli.ExitCode.UNAVAILABLE,
        detail=summary,
    )


if __name__ == "__main__":
    main()
