#!/usr/bin/env python3
"""Decide whether user identity may be disclosed to one web route."""

from __future__ import annotations

import os
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any
from urllib.parse import SplitResult, urlsplit

import tomllib

AGENTS_ROOT = Path(os.environ.get("AGENTS_DIR", Path(__file__).resolve().parent.parent))
if str(AGENTS_ROOT) not in sys.path:
    sys.path.insert(0, str(AGENTS_ROOT))

import acli

DISCLOSURES = {"anonymous", "account", "contact"}
ACTIONS = {"read", "write"}
DECISIONS = {"allow", "ask", "deny"}
EXIT_BY_DECISION = {"allow": 0, "ask": 3, "deny": 4}
EXIT_CODES = {
    0: "identity disclosure is allowed; the underlying action is not authorized",
    2: "invalid arguments, URL, or policy",
    3: "no consent decision; stop and ask the user",
    4: "identity disclosure is denied",
}


@dataclass(frozen=True)
class Route:
    origin: str
    path: str


@dataclass(frozen=True)
class ConsentRule:
    origin: str
    path_prefix: str
    disclosures: frozenset[str]
    actions: frozenset[str]
    decision: str
    reason: str | None


def normalized_route(raw_url: str) -> Route:
    try:
        parsed = urlsplit(raw_url)
        port = parsed.port
    except ValueError as exc:
        raise ValueError(f"invalid URL: {exc}") from exc
    if parsed.scheme.lower() not in {"http", "https"} or not parsed.hostname:
        raise ValueError("URL must use http or https and include a host")
    if parsed.username is not None or parsed.password is not None:
        raise ValueError("URL userinfo can disclose identity; remove it")
    try:
        host = parsed.hostname.encode("idna").decode("ascii").lower()
    except UnicodeError as exc:
        raise ValueError(f"invalid URL host: {exc}") from exc
    scheme = parsed.scheme.lower()
    default_port = 80 if scheme == "http" else 443
    if ":" in host:
        host = f"[{host}]"
    origin = f"{scheme}://{host}"
    if port is not None and port != default_port:
        origin += f":{port}"
    path = parsed.path or "/"
    return Route(origin, path)


def string_set(value: Any, field: str, allowed: set[str]) -> frozenset[str]:
    if not isinstance(value, list) or not value:
        raise ValueError(f"{field} must be a nonempty array")
    if not all(isinstance(item, str) for item in value):
        raise ValueError(f"{field} entries must be strings")
    result = frozenset(value)
    unknown = sorted(result - allowed)
    if unknown:
        raise ValueError(f"{field} contains unsupported values: {', '.join(unknown)}")
    return result


def parse_rule(raw: Any, index: int) -> ConsentRule:
    label = f"rule {index}"
    if not isinstance(raw, dict):
        raise TypeError(f"{label} must be a table")
    unknown = sorted(
        set(raw)
        - {"origin", "path_prefix", "disclosures", "actions", "decision", "reason"}
    )
    if unknown:
        raise ValueError(f"{label} has unknown fields: {', '.join(unknown)}")
    origin_value = raw.get("origin")
    if not isinstance(origin_value, str):
        raise TypeError(f"{label}.origin must be a string")
    parsed_origin: SplitResult = urlsplit(origin_value)
    route = normalized_route(origin_value)
    if (
        parsed_origin.path not in {"", "/"}
        or parsed_origin.query
        or parsed_origin.fragment
    ):
        raise ValueError(f"{label}.origin must not include a path, query, or fragment")
    path_prefix = raw.get("path_prefix", "/")
    if not isinstance(path_prefix, str) or not path_prefix.startswith("/"):
        raise ValueError(f"{label}.path_prefix must start with /")
    if path_prefix != "/" and path_prefix.endswith("//"):
        raise ValueError(f"{label}.path_prefix has an empty trailing segment")
    decision = raw.get("decision")
    if decision not in DECISIONS:
        raise ValueError(f"{label}.decision must be allow, ask, or deny")
    reason = raw.get("reason")
    if reason is not None and not isinstance(reason, str):
        raise ValueError(f"{label}.reason must be a string")
    return ConsentRule(
        origin=route.origin,
        path_prefix=path_prefix,
        disclosures=string_set(
            raw.get("disclosures"), f"{label}.disclosures", DISCLOSURES
        ),
        actions=string_set(raw.get("actions"), f"{label}.actions", ACTIONS),
        decision=decision,
        reason=reason,
    )


def load_rules(path: Path) -> tuple[list[ConsentRule], bool]:
    if not path.exists():
        return [], False
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, tomllib.TOMLDecodeError) as exc:
        raise ValueError(f"cannot read policy {path}: {exc}") from exc
    if set(data) - {"version", "rule"}:
        unknown = ", ".join(sorted(set(data) - {"version", "rule"}))
        raise ValueError(f"policy has unknown top-level fields: {unknown}")
    if data.get("version") != 1:
        raise ValueError("policy version must be 1")
    raw_rules = data.get("rule", [])
    if not isinstance(raw_rules, list):
        raise TypeError("policy rule must be an array of tables")
    return [parse_rule(raw, index) for index, raw in enumerate(raw_rules, 1)], True


def path_matches(path: str, prefix: str) -> bool:
    if prefix == "/":
        return True
    trimmed = prefix.rstrip("/")
    return path == trimmed or path.startswith(trimmed + "/")


def decide(
    route: Route,
    disclosure: str,
    action: str,
    rules: list[ConsentRule],
) -> tuple[str, ConsentRule | None]:
    if disclosure == "anonymous":
        return "allow", None
    matches = [
        rule
        for rule in rules
        if rule.origin == route.origin
        and disclosure in rule.disclosures
        and action in rule.actions
        and path_matches(route.path, rule.path_prefix)
    ]
    if not matches:
        return "ask", None
    specificity = max(len(rule.path_prefix.rstrip("/")) for rule in matches)
    winners = [
        rule for rule in matches if len(rule.path_prefix.rstrip("/")) == specificity
    ]
    decisions = {rule.decision for rule in winners}
    if len(decisions) != 1:
        raise ValueError(
            f"conflicting decisions for {route.origin}{route.path} at equal specificity"
        )
    return winners[0].decision, winners[0]


def build_parser():
    parser = acli.argument_parser(
        prog="web-identity-consent",
        description=(
            "Return allow, ask, or deny for identity disclosure to one HTTP(S) route. "
            "This never authorizes the request's side effect. "
            "Spec: topics/helper-scripts.md § web-identity-consent."
        ),
        capabilities=(),
        exit_codes=EXIT_CODES,
    )
    parser.add_argument(
        "url", help="Effective destination URL; never include credentials."
    )
    parser.add_argument("--disclosure", choices=sorted(DISCLOSURES), required=True)
    parser.add_argument("--action", choices=sorted(ACTIONS), required=True)
    parser.add_argument(
        "--config",
        type=Path,
        default=AGENTS_ROOT / "web-identity-consent.toml",
        help="Private TOML policy (default: ~/agents/web-identity-consent.toml).",
    )
    acli.add_standard_args(parser)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        route = normalized_route(args.url)
        if args.disclosure == "anonymous":
            rules, config_present = [], args.config.exists()
        else:
            rules, config_present = load_rules(args.config)
        decision, rule = decide(route, args.disclosure, args.action, rules)
        output_format = acli.resolve_format(args)
    except (TypeError, ValueError) as exc:
        acli.die(str(exc), acli.ExitCode.USAGE)
    result = {
        "decision": decision,
        "origin": route.origin,
        "path": route.path,
        "disclosure": args.disclosure,
        "action": args.action,
        "config": str(args.config),
        "config_present": config_present,
        "matched": (
            {
                "origin": rule.origin,
                "path_prefix": rule.path_prefix,
                "decision": rule.decision,
                "reason": rule.reason,
            }
            if rule
            else None
        ),
        "side_effect_authorized": False,
    }
    text = f"{decision}: {route.origin}{route.path} ({args.disclosure}, {args.action})"
    acli.emit(result, output_format, text=text)
    return EXIT_BY_DECISION[decision]


if __name__ == "__main__":
    sys.exit(main())
