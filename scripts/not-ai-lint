#!/usr/bin/env python3
# acli: 1 complete +commentary
"""not-ai-lint — advisory flags for prose patterns readers associate with AI.

Reads Markdown or plain text (files, or stdin when none are given), skips
code, URLs, and HTML comments, and reports:

  findings  each matched pattern with line, column, and excerpt;
  score     0-100: the fitted probability that a text with these pattern
            rates is AI-written, from a logistic model over per-1000-word
            rates trained on a balanced human/AI corpus. Only rules with a
            measured positive association are scored; the rest are listed
            as unscored flags.

The output focuses a reviewer's attention; it is not grounds for an edit on
its own. The lexicon and weights are derived by skills/not-ai/validate.py,
whose results (including where the score misleads) are in
skills/not-ai/validation.md.
"""

from __future__ import annotations

import json
import math
import re
import sys
from dataclasses import dataclass
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from acli import (
    ExitCode,
