#!/usr/bin/env python3
# acli: 1 complete +commentary
"""not-ai-lint — where to look for constructions readers take as AI-written.

Reads Markdown, Quarto, plain text, or PDF (files, or stdin when none are
given), keeps only the prose a reader sees (prose_text: code, math, paths,
citations, HTML comments, hidden Quarto blocks, tables, and References
sections are blanked in place), and runs the vendored declauding scan
(skills/declauding/scripts/declaude_lint.py) over what is left. Each
candidate is reported at its source line under the scan's category name,
which is the vocabulary of skills/declauding/references/register.md.

The output is a list of places to read, not a detector and not a score: the
scan misses most paragraph-level staging, and a category count is not a
revision target. Skill: skills/not-ai/SKILL.md.
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from acli import (
    ExitCode,
    Format,
    add_standard_args,
    argument_parser,
    commentary,
    die,
    emit,
    maybe_complete,
    resolve_format,
)
from prose_text import ExtractionError, Prose, from_markdown, load

SCAN = _REPO_ROOT / "skills" / "declauding" / "scripts" / "declaude_lint.py"
CAPABILITIES = ("complete", "+commentary")
EXIT_CODES = {
    3: "the vendored scan (skills/declauding) is missing or did not return its JSON report",
    4: "an input file does not exist or is not readable text",
    5: "--since needs each input inside a git work tree and a revision git can resolve",
    69: "a .pdf input needs pdftotext (poppler-utils), which is not installed or failed",
}
DEFAULT_LIMIT = 40
TOP_MATCHES = 3
INCLUDE = re.compile(r"\{\{<\s*include\s+(\S+)\s*>\}\}")
HTML_COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)
REUSE_OF = re.compile(r"\[([a-z-]+)\]")
HUNK = re.compile(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@", re.MULTILINE)


def manuscript_files(root: Path) -> list[Path]:
    """The root and every file its live Quarto include directives name, in order."""
    source = HTML_COMMENT.sub("", root.read_text(encoding="utf-8"))
    return [root, *(root.parent / name for name in INCLUDE.findall(source))]


def _git(path: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", *args],
        cwd=path.parent,
        capture_output=True,
        check=False,
        text=True,
    )


def changed_lines(path: Path, revision: str) -> set[int] | None:
    """Lines of the working-tree file added or changed since `revision`.

    None means every line: the file did not exist at that revision.
    """
    path = path.resolve()
    known = _git(path, "rev-parse", "--verify", "--quiet", "--end-of-options", revision)
    if known.returncode != 0:
        die(
            f"{path}: --since {revision}: not a revision git can resolve here "
            f"{known.stderr.strip()}".rstrip(),
            ExitCode.CONFLICT,
        )
    commit = known.stdout.strip()
    if _git(path, "cat-file", "-e", f"{commit}:./{path.name}").returncode != 0:
        return None
    proc = _git(
        path,
        "diff",
        "-U0",
        "--inter-hunk-context=0",
        "--no-ext-diff",
        "--no-color",
        commit,
        "--",
        path.name,
    )
    if proc.returncode != 0:
        die(f"{path}: git diff {revision}: {proc.stderr.strip()}", ExitCode.CONFLICT)
    lines: set[int] = set()
    for start, count in HUNK.findall(proc.stdout):
        first = int(start)
        lines.update(range(first, first + int(count or 1)))
    return lines


def scan_text(prose: Prose) -> tuple[str, list[int]]:
    """The prose as the scan expects it, and each scanned row's source line.

    The scan's paragraph rules count one blank row between paragraphs, so a
    run of skipped or blank lines is sent as a single empty row (source 0).
    Tables are left out.
    """
    rows: list[str] = []
    source: list[int] = []
    previous = 0
    for line in prose.lines:
        if line.kind == "table" or not line.text.strip():
            continue
        if rows and line.number != previous + 1:
            rows.append("")
            source.append(0)
        rows.append(line.text)
        source.append(line.number)
        previous = line.number
    return "\n".join(rows) + "\n", source


def scan(text: str, options: list[str]) -> list[dict]:
    """Run the vendored scan; its exit status 1 only means it found candidates."""
    proc = subprocess.run(
        [sys.executable, str(SCAN), "-", "--json", "--no-html", *options],
        input=text,
        capture_output=True,
        check=False,
        text=True,
    )
    try:
        return json.loads(proc.stdout)["hits"]
    except (json.JSONDecodeError, KeyError, TypeError):
        die(
            f"{SCAN}: exit {proc.returncode} without a JSON report: {proc.stderr.strip()[:300]}",
            ExitCode.DATA,
        )


def _read(path: str) -> Prose:
    if path == "-":
        return from_markdown(sys.stdin.read())
    try:
        return load(path)
    except ExtractionError as exc:
        die(str(exc), ExitCode.UNAVAILABLE)
    except (OSError, UnicodeDecodeError) as exc:
        die(f"{path}: {exc}", ExitCode.NOT_FOUND)


def report(path: str, args, limit: int | None) -> dict:
    prose = _read(path)
    notes = list(prose.notes)
    options = [
        flag
        for flag, on in (
            ("--skip-quoted", args.skip_quoted),
            ("--statement-headers", args.statement_headers),
        )
        if on
    ]
    text, source = scan_text(prose)
    hits = []
    for h in scan(text, options):
        # A reuse line restates candidates of the category named in its note.
        restated = REUSE_OF.match(h["note"]) if h["category"] == "reuse" else None
        if h["category"] in args.skip or (restated and restated.group(1) in args.skip):
            continue
        hits.append({**h, "line": source[h["line"] - 1] if h["line"] else 0})
    if args.since:
        if path == "-" or prose.format == "pdf":
            die(
                "--since needs Markdown, Quarto, or text files: stdin and PDF "
                "have no line history",
                ExitCode.USAGE,
            )
        changed = changed_lines(Path(path), args.since)
        whole = sum(1 for h in hits if not h["line"])
        hits = [
            h for h in hits if h["line"] and (changed is None or h["line"] in changed)
        ]
        notes.append(
            f"Only lines changed since {args.since} are reported"
            + (" (the whole file: it is new since then)" if changed is None else "")
            + f"; {whole} whole-document candidates (repetition, density) are "
            "omitted because they have no line."
        )
    hits.sort(key=lambda h: (h["line"], h.get("col", 0)))
    findings = [
        {
            "line": h["line"],
            "loc": prose.locator(h["line"]) if h["line"] else "-",
            "col": h["col"] + 1 if "col" in h else 0,
            "category": h["category"],
            "note": h["note"],
            "match": " ".join(h["match"].split()),
        }
        for h in hits
    ]
    by_category: dict[str, dict] = {}
    for category, count in Counter(f["category"] for f in findings).most_common():
        matches = Counter(
            f["match"].lower() for f in findings if f["category"] == category
        )
        by_category[category] = {
            "count": count,
            "top": [match for match, _ in matches.most_common(TOP_MATCHES)],
        }
    return {
        "path": path,
        "format": prose.format,
        "notes": notes,
        "words": prose.words(),
        "by_category": by_category,
        "findings": findings if limit is None else findings[:limit],
        "findings_total": len(findings),
    }


def _text_report(reports: list[dict]) -> str:
    out: list[str] = []
    for item in reports:
        out.append(
            f"{item['path']}: {item['findings_total']} candidates in "
            f"{len(item['by_category'])} categories, {item['words']} prose words"
        )
        out.extend(f"  note: {note}" for note in item["notes"])
        for category, stats in item["by_category"].items():
            out.append(
                f"  {category:<16} {stats['count']:>3}  {' | '.join(stats['top'])}"
            )
        for f in item["findings"]:
            out.append(
                f"{item['path']}:{f['loc']}:{f['col']}: [{f['category']}] "
                f"{f['match']} — {f['note']}"
            )
        hidden = item["findings_total"] - len(item["findings"])
        if hidden > 0:
            out.append(f"  ... {hidden} more candidates (--limit 0 shows all)")
    out.append(
        "Advisory: candidates mark places to read, not required edits, and the scan "
        "misses most paragraph-level staging. Each category is explained by an entry of "
        "skills/declauding/references/register.md."
    )
    return "\n".join(out)


def build_parser():
    parser = argument_parser(
        prog="not-ai-lint",
        description=(
            "Lists where prose uses constructions readers take as AI-written, by source line\n"
            "and named category. Reads Markdown, Quarto, text, or PDF (via pdftotext), keeps\n"
            "only reader-facing prose (prose_text module), and runs the vendored declauding\n"
            "scan over it. Instant; one JSON record per input on stdout. No score: candidates\n"
            "focus a read and do not authorize edits. Skill: skills/not-ai/SKILL.md."
        ),
        capabilities=CAPABILITIES,
        exit_codes=EXIT_CODES,
    )
    parser.add_argument(
        "paths", nargs="*", help="Files to check; '-' or none reads stdin."
    )
    parser.add_argument(
        "--manuscript",
        metavar="ROOT",
        action="append",
        default=None,
        help=(
            "A Quarto root file: check it and every file its `{{< include >}}` directives "
            "name, in manuscript order. Includes inside HTML comments are not part of the "
            "manuscript and are left out. Repeatable; combines with paths."
        ),
    )
    parser.add_argument(
        "--since",
        metavar="REVISION",
        help=(
            "Report only candidates on lines added or changed since this git revision "
            "(working tree against REVISION). Whole-document candidates are omitted."
        ),
    )
    parser.add_argument(
        "--skip",
        metavar="CATEGORY",
        action="append",
        default=None,
        help="Leave out one category (e.g. typography for a typeset paper). Repeatable.",
    )
    parser.add_argument(
        "--skip-quoted",
        action="store_true",
        help="Ignore blockquotes and *italic* spans, for prose that quotes specimens.",
    )
    parser.add_argument(
        "--statement-headers",
        action="store_true",
        help="Headings are written as findings by house style: skip the thesis-header rule.",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=DEFAULT_LIMIT,
        help=f"Candidates listed per input (default {DEFAULT_LIMIT}; 0 = all). Counts cover all.",
    )
    add_standard_args(parser)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    maybe_complete(parser, [sys.argv[0], *(argv if argv is not None else sys.argv[1:])])
    args = parser.parse_args(argv)
    try:
        fmt = resolve_format(args)
    except ValueError as exc:
        die(str(exc), ExitCode.USAGE)
    args.skip = set(args.skip or ())
    paths = list(args.paths)
    for root in args.manuscript or ():
        try:
            paths.extend(str(path) for path in manuscript_files(Path(root)))
        except (OSError, UnicodeDecodeError) as exc:
            die(f"{root}: {exc}", ExitCode.NOT_FOUND)
    if not SCAN.is_file():
        die(f"{SCAN} is missing", ExitCode.DATA)
    limit = None if args.full or args.limit == 0 else args.limit
    reports = [report(path, args, limit) for path in paths or ["-"]]
    if fmt is Format.TEXT:
        emit(reports, fmt, text=_text_report(reports))
        return 0
    emit(
        [
            commentary(
                f"{r['findings_total']} candidates over {r['words']} prose words; they mark "
                "places to read, not required edits.",
                *r["notes"],
                value=r,
            )
            for r in reports
        ],
        fmt,
        commentary=not args.no_commentary,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
