    add_standard_args,
    argument_parser,
    commentary,
    die,
    emit,
    maybe_complete,
    resolve_format,
)

DATA_DIR = _REPO_ROOT / "skills" / "not-ai" / "data"
LEXICON_PATH = DATA_DIR / "lexicon.tsv"
WEIGHTS_PATH = DATA_DIR / "weights.json"
CAPABILITIES = ("complete", "+commentary")
EXIT_CODES = {
    3: "the derived lexicon or weights are missing or malformed (run skills/not-ai/validate.py)",
    4: "an input file does not exist or is not readable text",
}
DEFAULT_LIMIT = 40
# Below this many prose words a density score mostly measures one sentence.
MIN_WORDS_FOR_SCORE = 150


def _alternation(items: list[str]) -> str:
    return "|".join(
        re.escape(item) for item in sorted(set(items), key=len, reverse=True)
    )


def _phrase_rule(*phrases: str) -> re.Pattern[str]:
    return re.compile(r"\b(?:" + _alternation(list(phrases)) + r")\b", re.IGNORECASE)


@dataclass(frozen=True)
class Rule:
    id: str
    evidence: str  # "study" | "guide" | "lore"
    note: str


RULES: tuple[Rule, ...] = (
    Rule(
        "excess-vocab",
        "study",
        "word several times more frequent in LLM than human text; use the plain word or cut",
    ),
    Rule(
        "stock-phrase",
        "study",
        "stock phrase or figure; say the literal thing or cut (writing § Sentences)",
