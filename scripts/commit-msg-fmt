#!/usr/bin/env python3
"""commit-msg-fmt — format a plain-prose commit message.

Spec: topics/helper-scripts.md (commit-msg-fmt entry) in the
agents-instructions repo.
With -m args, the first is the subject (passed through unwrapped) and
subsequent args are wrapped to 71 cols. With no args, stdin supplies the
subject line and blank-line-separated body paragraphs. Empty input or an
empty subject exits 2. A literal backslash-n exits 1.
"""

from __future__ import annotations

import argparse
import sys
import textwrap

BODY_WIDTH = 71


def messages_from_stdin(text: str) -> list[str]:
    lines = text.splitlines()
    if not lines:
        return []

    messages = [lines[0]]
    paragraph: list[str] = []
    for line in lines[1:]:
        if line.strip():
            paragraph.append(line)
            continue
        if paragraph:
            messages.append(" ".join(paragraph))
            paragraph = []
        messages.append("")
    if paragraph:
        messages.append(" ".join(paragraph))
    return messages


def main() -> int:
    p = argparse.ArgumentParser(
        description=(
            "Format a plain-prose commit message from -m args or stdin; "
            "the subject is unwrapped and body paragraphs wrap to 71 cols."
        ),
        prog="commit-msg-fmt",
    )
    p.add_argument(
        "-m",
        action="append",
        default=[],
        dest="messages",
        metavar="MSG",
        help=(
            "message paragraph; first is the subject (unwrapped); "
            "subsequent ones are wrapped to 71 cols; '' inserts a "
            "blank line"
        ),
    )
    args = p.parse_args()

    if args.messages:
        messages = args.messages
        literal_sources = (
            (message, f"-m {index}") for index, message in enumerate(messages, start=1)
        )
    else:
        stdin_text = sys.stdin.read()
        messages = messages_from_stdin(stdin_text)
        literal_sources = (
            (line, f"stdin line {index}")
            for index, line in enumerate(stdin_text.splitlines(), start=1)
        )

    if not messages:
        print("commit-msg-fmt: empty stdin", file=sys.stderr)
        return 2
    if not messages[0].strip():
        print("commit-msg-fmt: empty subject", file=sys.stderr)
        return 2
    for message, source in literal_sources:
        if "\\n" in message:
            print(
                f"commit-msg-fmt: literal '\\n' in {source}; "
                "use an input line or separate -m argument",
                file=sys.stderr,
            )
            return 1

    out: list[str] = []
    for i, msg in enumerate(messages):
        if i == 0:
            out.append(msg)
        elif msg == "":
            out.append("")
        else:
            wrapped = textwrap.fill(
                msg,
                width=BODY_WIDTH,
                break_long_words=False,
                break_on_hyphens=False,
            )
            out.append(wrapped)
    sys.stdout.write("\n".join(out) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
