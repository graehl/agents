#!/usr/bin/env bash
# pre-push-no-attrib: refuse to push commits whose messages carry
# AI-attribution markers — any Co-Authored-By trailer (regardless of
# the author it names) or a generated-with banner line. Mechanical
# enforcement of the [no-attrib] check in ~/agents/AGENTS.global.md
# § Big-effect command gate; strip flow:
# ~/agents/topics/commits.md § Attribution strip by SHA.
#
# Install per repo (machine-local, .git/hooks is untracked):
#   ln -s ~/agents/scripts/pre-push-no-attrib <repo>/.git/hooks/pre-push
#
# git calls this with args <remote-name> <remote-url> and stdin lines
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
#
# Detection is line-anchored, so prose that merely mentions a trailer —
# this script's own history, for one — is not itself a violation. It is
# deliberately not restricted to the trailing trailer block:
# `git interpret-trailers --parse` reads only that block, and so missed
# a trailer followed by more prose, or by a bullet that breaks the block
# (verified 2026-09-17). A destination that scans plainly rejects those,
# so this has to as well, or the push that fails is the second one and
# the commit is already in shared history.
#
# Author and committer identity are checked too. A message can be clean
# while the commit is still authored from a no-reply bot address, which
# a message-only scan never sees.
set -u
zero=0000000000000000000000000000000000000000
remote_name=${1:-}
bad=0
while read -r _lref lsha _rref rsha; do
	[ "$lsha" = "$zero" ] && continue # ref deletion: nothing outgoing
	if [ "$rsha" = "$zero" ]; then
		# A new ref may contain commits already present on another remote but
		# still new to this destination. Exclude only destination-tracking
		# tips; with none, conservatively scan the full reachable history.
		rev_args=("$lsha")
		while IFS= read -r tip; do
			[ -n "$tip" ] && rev_args+=("^$tip")
		done < <(git for-each-ref --format='%(objectname)' \
			"refs/remotes/$remote_name/")
	else
		rev_args=("$rsha..$lsha")
	fi
	for c in $(git rev-list "${rev_args[@]}"); do
		msg=$(git log -1 --format=%B "$c")
		trailer=$(printf '%s\n' "$msg" | grep -iE '^[[:space:]]*co-authored-by:')
		banner=$(printf '%s\n' "$msg" | grep -iE '^[[:space:]]*(🤖|generated with)')
		identity=$(git log -1 --format='%an <%ae>%n%cn <%ce>' "$c" |
			sort -u | grep -iE 'noreply@|\[bot\]')
		if [ -n "$trailer$banner$identity" ]; then
			bad=1
			echo "no-attrib: $(git log -1 --format='%h %s' "$c")" >&2
			printf '%s\n' "$trailer" "$banner" "$identity" |
				sed '/^$/d; s/^/  /' >&2
		fi
	done
done
if [ "$bad" -ne 0 ]; then
	echo "no-attrib: push refused — strip the marked commits by SHA first" >&2
	echo "  flow: ~/agents/topics/commits.md 'Attribution strip by SHA'" >&2
	exit 1
fi
exit 0
