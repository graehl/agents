#!/usr/bin/env python3
"""Read, create and update Jira Cloud issues from an agent session.

The credential is never passed on a command line. It comes from the
environment when already exported, otherwise from sourcing the user's
`~/keys.sh` in a throwaway shell and reading JIRA_API_TOKEN back over a
pipe. The file is never printed, and no verb echoes the token.

This is the issue counterpart to `confluence`;
both share the same Atlassian credential. The mutating verbs are narrow:
`comment` adds one comment written in Jira wiki markup (`||h||` header
rows, `|c|` cells, `*bold*`), or in Markdown with `--markdown`, and never
edits or deletes existing ones;
`create` files one issue from a Markdown description; `update` sets an
issue's story points or sprint; `transition` moves it to a named status.
Nothing here deletes. Field ids, boards and sprints are looked up by name
on each call, so no site's ids are baked in.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from base64 import b64encode
from pathlib import Path

AGENTS_ROOT = Path(os.environ.get("AGENTS_DIR", Path.home() / "agents"))
if str(AGENTS_ROOT) not in sys.path:
    sys.path.insert(0, str(AGENTS_ROOT))

import acli

KEYS_FILE = Path(os.environ.get("JIRA_KEYS_FILE", Path.home() / "keys.sh"))
TOKEN_VARS = (
    "JIRA_API_TOKEN",
    "AGENT_JIRA_API_TOKEN",
    "YEP_JIRA_API_TOKEN",
    "CONFLUENCE_API_TOKEN",
)
# Site and account are machine-local facts, so they come from the environment
# or the same keys file as the token, never from a default baked in here.
SITE_VARS = ("JIRA_SITE",)
EMAIL_VARS = ("JIRA_EMAIL",)
CAPABILITIES = ("complete", "+toon")
EXIT_CODES = {
    0: "success",
    2: "usage error",
    3: "unusable response or body",
    4: "issue, field, sprint, status or credential source not found",
    69: "Jira unreachable or rejected the credential",
}


# --- credential -----------------------------------------------------------


_keys_file_values: dict[str, str] | None = None


def _keys_file() -> dict[str, str]:
    """The settings this tool reads from the sourced keys file, sourced once.

    Sourcing happens in a child shell whose only output is `name=value` lines
    for the variables named here, so the keys file's other contents never
    reach this process or any log.
    """
    global _keys_file_values
    if _keys_file_values is not None:
        return _keys_file_values
    _keys_file_values = {}
    if not KEYS_FILE.is_file():
        return _keys_file_values
    wanted = (*TOKEN_VARS, *SITE_VARS, *EMAIL_VARS)
    script = (
        f". {KEYS_FILE!s} >/dev/null 2>&1 || exit 1\n"
        "for v in " + " ".join(wanted) + "; do\n"
        '  eval "val=\\${$v:-}"\n'
        '  [ -n "$val" ] && printf "%s=%s\\n" "$v" "$val"\n'
        "done\nexit 0\n"
    )
    done = subprocess.run(
        ["bash", "-c", script],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,  # an unsourceable keys file reads as empty; callers die
    )
    for line in done.stdout.splitlines():
        name, sep, value = line.partition("=")
        if sep and value.strip():
            _keys_file_values[name] = value.strip()
    return _keys_file_values


def _setting(names: tuple[str, ...], what: str) -> str:
    """A setting from the environment, else the keys file, else a clear refusal."""
    for name in names:
        value = os.environ.get(name, "").strip()
        if value:
            return value
    values = _keys_file()
    for name in names:
        if values.get(name):
            return values[name]
    acli.die(
        f"no {what}: set {' or '.join(names)} in the environment or in {KEYS_FILE}",
        acli.ExitCode.NOT_FOUND,
    )


def _token() -> str:
    return _setting(TOKEN_VARS, "API token")


# --- transport ------------------------------------------------------------


def _request(
    args,
    method: str,
    path: str,
    payload: dict | None = None,
    *,
    absent_on: tuple[int, ...] = (),
) -> dict | None:
    """The JSON reply; `None` when the status is one of `absent_on`, else die."""
    site = args.site.rstrip("/")
    url = path if path.startswith("http") else f"{site}{path}"
    basic = b64encode(f"{args.email}:{_token()}".encode()).decode()
    body = None if payload is None else json.dumps(payload).encode()
    request = urllib.request.Request(url, data=body, method=method)
    request.add_header("Authorization", f"Basic {basic}")
    request.add_header("Accept", "application/json")
    if body is not None:
        request.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(request, timeout=args.timeout) as response:
            raw = response.read().decode("utf-8")
    except urllib.error.HTTPError as err:
        if err.code in absent_on:
            return None
        detail = err.read().decode("utf-8", "replace")[:600]
        code = {
            401: acli.ExitCode.UNAVAILABLE,
            403: acli.ExitCode.UNAVAILABLE,
            404: acli.ExitCode.NOT_FOUND,
        }.get(err.code, acli.ExitCode.UNAVAILABLE)
        hint = ""
        if err.code in (401, 403):
            hint = " (token rejected; regenerate it at id.atlassian.com)"
        acli.die(
            f"{method} {url} returned {err.code}{hint}",
            code,
            detail={"status": err.code, "body": detail},
        )
    except urllib.error.URLError as err:
        acli.die(f"{method} {url} failed: {err.reason}", acli.ExitCode.UNAVAILABLE)
    if not raw:
        return {}
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        acli.die(f"{method} {url} returned non-JSON", acli.ExitCode.DATA)


def _field_name(value) -> str:
    if not value:
        return ""
    return value.get("name") or value.get("value") or str(value)


def _fields(issue: dict, site: str) -> dict:
    """Flatten the nested `fields` object of an issue into compact rows."""
    key = issue.get("key", "")
    fields = issue.get("fields") or {}
    assignee = fields.get("assignee") or {}
    reporter = fields.get("reporter") or {}
    return {
        "key": key,
        "summary": fields.get("summary"),
        "status": _field_name(fields.get("status")),
        "assignee": assignee.get("displayName"),
        "reporter": reporter.get("displayName"),
        "created": fields.get("created"),
        "updated": fields.get("updated"),
        "url": f"{site}/browse/{key}",
    }


def _adf_text(node, out: list[str] | None = None) -> str:
    """Flatten a Jira Atlassian Document Format tree into plain text.

    Fields like `description` and comment `body` arrive as ADF JSON in the
    Cloud REST API. Accepts a string (returned unchanged) or a node tree.
    """
    if node is None:
        return ""
    if isinstance(node, str):
        return node
    if not isinstance(node, dict):
        return str(node)
    out_local = False
    if out is None:
        out = []
        out_local = True
    node_type = node.get("type")
    if node_type == "text":  # includes `text`/`marks`
        out.append(node.get("text", ""))
    elif node_type in ("paragraph", "heading", "codeBlock", "listItem", "blockquote"):
        for content in node.get("content", []):
            _adf_text(content, out)
        if node_type != "listItem":
            out.append("\n")
    elif node_type in ("bulletList", "orderedList") or node_type == "table":
        for content in node.get("content", []):
            _adf_text(content, out)
    elif node_type in ("tableRow", "tableCell", "tableHeader"):
        for content in node.get("content", []):
            _adf_text(content, out)
        if node_type == "tableRow":
            out.append("\n")
    elif node_type == "hardBreak":
        out.append("\n")
    elif node_type is None and "text" in node:
        out.append(node.get("text", ""))
    else:  # unknown container (e.g. panel, rule)
        for content in node.get("content", []):
            _adf_text(content, out)
    return "".join(out) if out_local else ""


_INLINE = re.compile(
    r"`(?P<code>[^`]+)`"
    r"|(?<![\w*])\*\*(?P<strong>[^*\s](?:.*?[^*\s])?)\*\*(?![\w*])"
    r"|\[(?P<label>[^\]]+)\]\((?P<href>[^)\s]+)\)"
    r"|(?<![\w*])\*(?P<em>[^*\s](?:[^*]*[^*\s])?)\*(?!\w)"
)
_HEADING = re.compile(r"(?P<marks>#{1,6})\s+(?P<text>.+)")
_ITEM = re.compile(r"(?:(?P<bullet>[-*+])|(?P<number>\d+)[.)])\s+(?P<text>.+)")
_FENCE = "```"


def _adf_inline(text: str) -> list[dict]:
    """Text nodes for one run of Markdown: code, bold, emphasis and links."""
    nodes: list[dict] = []

    def add(piece: str, mark: dict | None = None) -> None:
        if piece:
            node = {"type": "text", "text": piece}
            if mark:
                node["marks"] = [mark]
            nodes.append(node)

    at = 0
    for match in _INLINE.finditer(text):
        add(text[at : match.start()])
        if match["code"] is not None:
            add(match["code"], {"type": "code"})
        elif match["strong"] is not None:
            add(match["strong"], {"type": "strong"})
        elif match["label"] is not None:
            add(match["label"], {"type": "link", "attrs": {"href": match["href"]}})
        else:
            add(match["em"], {"type": "em"})
        at = match.end()
    add(text[at:])
    return nodes


def _adf_block(kind: str, text: str, **attrs) -> dict:
    node = {"type": kind, "content": _adf_inline(text)}
    if attrs:
        node["attrs"] = attrs
    return node


def markdown_to_adf(markdown: str) -> dict:
    """An Atlassian Document Format document from plain Markdown.

    Handles what a ticket description uses: paragraphs, `#` headings, fenced
    code, bullet and numbered lists, and the inline marks of `_adf_inline`.
    A nested list flattens into its parent, and marks do not nest; anything
    else (tables, images, quotes) stays literal paragraph text.
    """
    blocks: list[dict] = []
    paragraph: list[str] = []
    items: list[str] = []
    list_kind = ""
    first_number = 1

    def close() -> None:
        nonlocal list_kind
        if paragraph:
            blocks.append(_adf_block("paragraph", " ".join(paragraph)))
            paragraph.clear()
        if items:
            rows = [
                {"type": "listItem", "content": [_adf_block("paragraph", item)]}
                for item in items
            ]
            block = {"type": list_kind, "content": rows}
            if list_kind == "orderedList" and first_number != 1:
                block["attrs"] = {"order": first_number}
            blocks.append(block)
            items.clear()
        list_kind = ""

    lines = markdown.splitlines()
    at = 0
    while at < len(lines):
        line = lines[at]
        text = line.strip()
        at += 1
        if text.startswith(_FENCE) and "`" not in text[len(_FENCE) :]:
            close()
            code: list[str] = []
            while at < len(lines) and not lines[at].strip().startswith(_FENCE):
                code.append(lines[at])
                at += 1
            at += 1  # the closing fence, or one past the end when it is missing
            block: dict = {"type": "codeBlock"}
            if text[len(_FENCE) :].strip():
                block["attrs"] = {"language": text[len(_FENCE) :].strip()}
            if body := "\n".join(code):
                block["content"] = [{"type": "text", "text": body}]
            blocks.append(block)
        elif not text:
            if paragraph:  # a blank line inside a list leaves the list open
                close()
        elif heading := _HEADING.fullmatch(text):
            close()
            level = len(heading["marks"])
            blocks.append(_adf_block("heading", heading["text"], level=level))
        elif (item := _ITEM.fullmatch(text)) and not (paragraph and item["number"]):
            # A number cannot interrupt a paragraph: "in\n2024. Then" is prose.
            kind = "bulletList" if item["bullet"] else "orderedList"
            if paragraph or (items and kind != list_kind and not line[:1].isspace()):
                close()
            if not items:
                list_kind = kind
                first_number = int(item["number"] or 1)
            items.append(item["text"])
        elif items and line[:1].isspace():
            items[-1] += " " + text  # wrapped continuation of the last item
        else:
            if items:
                close()
            paragraph.append(text)
    close()
    return {"type": "doc", "version": 1, "content": blocks}


def _comment_rows(issue: dict) -> list[dict]:
    comments = (((issue.get("fields") or {}).get("comment")) or {}).get("comments", [])
    return [
        {
            "author": (c.get("author") or {}).get("displayName"),
            "created": c.get("created"),
            "body": " ".join(_adf_text(c.get("body")).split()),
        }
        for c in comments
    ]


def _paged(args, path: str, limit: int) -> list[dict]:
    """Follow `nextPageToken` paging until `limit` issues or exhaustion.

    `/rest/api/3/search/jql` replaced the removed `/search` (CHANGE-2046);
    it pages by token, not `startAt`, and reports no `total`.
    """
    rows: list[dict] = []
    token = None
    while len(rows) < limit:
        query = f"maxResults={min(limit - len(rows), 100)}"
        if token:
            query += f"&nextPageToken={urllib.parse.quote(token, safe='')}"
        sep = "&" if "?" in path else "?"
        page = _request(args, "GET", f"{path}{sep}{query}")
        rows.extend(page.get("issues", []))
        token = page.get("nextPageToken")
        if page.get("isLast") or not token:
            break
    return rows[:limit]


# --- verbs ----------------------------------------------------------------


def cmd_whoami(args) -> dict:
    who = _request(args, "GET", "/rest/api/3/myself")
    return {
        "site": args.site,
        "display_name": who.get("displayName"),
        "email": who.get("emailAddress"),
        "account_id": who.get("accountId"),
        "token_source": "environment"
        if any(os.environ.get(v, "").strip() for v in TOKEN_VARS)
        else str(KEYS_FILE),
    }


_ISSUE_REF = re.compile(r"[A-Za-z][A-Za-z0-9_]*-[0-9]+|[0-9]+")


def issue_ref(value: str) -> str:
    """An issue key (AIP-2747) or numeric id; it becomes a request path segment."""
    if not _ISSUE_REF.fullmatch(value):
        raise argparse.ArgumentTypeError(
            f"not an issue key like AIP-2747 or a numeric id: {value!r}"
        )
    return value


def cmd_get(args) -> dict:
    query = (
        "?expand=renderedFields"
        if args.full
        else "?fields=summary,status,assignee,reporter,created,updated,comment,description"
    )
    issue = _request(args, "GET", f"/rest/api/3/issue/{args.issue}{query}")
    row = _fields(issue, args.site)
    row["description"] = _adf_text((issue.get("fields") or {}).get("description"))
    comments = _comment_rows(issue)
    row["comment_count"] = len(comments)
    if args.full:
        row["comments"] = comments
        custom = {
            k: v
            for k, v in (issue.get("fields") or {}).items()
            if k.startswith("customfield_")
        }
        if custom:
            row["custom_fields"] = custom
    return row


def cmd_search(args) -> dict:
    jql = urllib.parse.quote(args.jql, safe="")
    issues = _paged(
        args,
        f"/rest/api/3/search/jql?jql={jql}&fields=summary,status,assignee",
        args.limit,
    )
    rows = [_fields(i, args.site) for i in issues]
    return {
        "name": "issues",
        "columns": ["key", "summary", "status", "assignee"],
        "rows": rows,
    }


def cmd_comment(args) -> dict:
    body = (
        sys.stdin.read()
        if args.body_file == "-"
        else Path(args.body_file).read_text(encoding="utf-8")
    )
    if not body.strip():
        acli.die("refusing to post an empty comment", acli.ExitCode.DATA)
    result = {"issue": args.issue, "chars": len(body)}
    if args.dry_run:
        result["dry_run"] = True
        return result
    if args.markdown:  # API v3 takes the body as an ADF tree
        path, payload = f"/rest/api/3/issue/{args.issue}/comment", markdown_to_adf(body)
    else:  # API v2 takes it as wiki markup, which has tables the converter lacks
        path, payload = f"/rest/api/2/issue/{args.issue}/comment", body
    posted = _request(args, "POST", path, {"body": payload})
    comment_id = posted.get("id")
    result["id"] = comment_id
    result["url"] = f"{args.site}/browse/{args.issue}?focusedCommentId={comment_id}"
    return result


def _field_id(args, name: str) -> str:
    """The id of the one field with this display name, e.g. `Story Points`."""
    found = [
        f["id"] for f in _request(args, "GET", "/rest/api/3/field") if f["name"] == name
    ]
    if len(found) != 1:
        acli.die(
            f"expected one field named {name!r}, found {len(found)}",
            acli.ExitCode.NOT_FOUND,
            detail={"ids": found},
        )
    return found[0]


def _agile_values(args, path: str, *, absent_on: tuple[int, ...] = ()) -> list[dict]:
    """Every `values` row of a Jira Software listing, following `startAt` pages.

    A status in `absent_on` reads as an empty listing.
    """
    rows: list[dict] = []
    sep = "&" if "?" in path else "?"
    while True:
        page = _request(
            args, "GET", f"{path}{sep}startAt={len(rows)}", absent_on=absent_on
        )
        if page is None:
            return rows
        values = page.get("values", [])
        rows.extend(values)
        if page.get("isLast", True) or not values:
            return rows


def _sprints(args, project: str) -> list[dict]:
    """Active and future sprints on the project's boards, active first.

    Kanban boards never hold sprints and are skipped. A team-managed (`simple`)
    board answers 400 when its sprints feature is off, which reads as none.
    """
    boards = _agile_values(args, f"/rest/agile/1.0/board?projectKeyOrId={project}")
    seen: dict[int, dict] = {}
    for board in boards:
        if board.get("type") == "kanban":
            continue
        sprints = _agile_values(
            args,
            f"/rest/agile/1.0/board/{board['id']}/sprint?state=active,future",
            absent_on=(400,),
        )
        for sprint in sprints:
            seen.setdefault(
                sprint["id"],
                {
                    "id": sprint["id"],
                    "name": sprint["name"],
                    "state": sprint["state"],
                    "start": sprint.get("startDate"),
                    "end": sprint.get("endDate"),
                    "board": board["name"],
                },
            )
    return sorted(seen.values(), key=lambda s: (s["state"] != "active", s["name"]))


def _sprint(args, project: str, want: str) -> dict:
    """The sprint `want` names: `active` for the only active one, else a name."""
    sprints = _sprints(args, project)
    if want == "active":
        found = [s for s in sprints if s["state"] == "active"]
    else:
        found = [s for s in sprints if s["name"].casefold() == want.casefold()]
    if len(found) != 1:
        acli.die(
            f"--sprint {want}: {len(found)} matching sprints in {project}; "
            "name one of the sprints listed",
            acli.ExitCode.NOT_FOUND,
            detail={"sprints": [f"{s['name']} ({s['state']})" for s in sprints]},
        )
    return found[0]


def _transition(args, issue: str, want: str, *, dry_run: bool = False) -> str:
    """Move `issue` to the status `want` names; returns the resulting status.

    `want` matches a reachable status first, then a transition's own name,
    ignoring case. An issue already in that status is left alone. Only a
    single workflow step is taken: an unreachable status is refused with the
    reachable ones listed. A dry run resolves the step and does not take it.
    """
    fields = _request(args, "GET", f"/rest/api/3/issue/{issue}?fields=status")
    current = _field_name((fields.get("fields") or {}).get("status"))
    if current.casefold() == want.casefold():
        return current
    listed = _request(args, "GET", f"/rest/api/3/issue/{issue}/transitions")
    steps = listed.get("transitions", [])
    for label in (lambda t: t["to"]["name"], lambda t: t["name"]):
        for step in steps:
            if label(step).casefold() == want.casefold():
                if dry_run:
                    return step["to"]["name"]
                _request(
                    args,
                    "POST",
                    f"/rest/api/3/issue/{issue}/transitions",
                    {"transition": {"id": step["id"]}},
                )
                return step["to"]["name"]
    acli.die(
        f"{issue} is {current!r}; no single step reaches status {want!r}",
        acli.ExitCode.NOT_FOUND,
        detail={"reachable": [t["to"]["name"] for t in steps]},
    )


def _planning_fields(args, project: str, result: dict) -> dict:
    """The `--points` and `--sprint` options as issue fields; notes them in `result`."""
    fields: dict = {}
    if args.points is not None:
        fields[_field_id(args, args.points_field)] = args.points
        result["points"] = args.points
    if args.sprint:
        sprint = _sprint(args, project, args.sprint)
        fields[_field_id(args, "Sprint")] = sprint["id"]
        result["sprint"] = sprint["name"]
    return fields


def cmd_sprints(args) -> dict:
    return {
        "name": "sprints",
        "columns": ["id", "name", "state", "start", "end", "board"],
        "rows": _sprints(args, args.project),
    }


def cmd_create(args) -> dict:
    result: dict = {"project": args.project, "type": args.type}
    fields: dict = {
        "project": {"key": args.project},
        "issuetype": {"name": args.type},
        "summary": args.summary,
    }
    if args.description_file:
        markdown = (
            sys.stdin.read()
            if args.description_file == "-"
            else Path(args.description_file).read_text(encoding="utf-8")
        )
        fields["description"] = markdown_to_adf(markdown)
    if args.assignee == "me":
        who = _request(args, "GET", "/rest/api/3/myself")
        fields["assignee"] = {"accountId": who["accountId"]}
        result["assignee"] = who.get("displayName")
    fields.update(_planning_fields(args, args.project, result))
    if args.dry_run:
        return {**result, "dry_run": True, "status": args.status, "fields": fields}
    created = _request(args, "POST", "/rest/api/3/issue", {"fields": fields})
    key = created["key"]
    result |= {"key": key, "url": f"{args.site}/browse/{key}"}
    if args.status:
        try:
            result["status"] = _transition(args, key, args.status)
        except SystemExit:
            # The issue exists, so report it as created: a failing exit here
            # invites a retry that files a duplicate. `_transition` has
            # already written why, with the reachable statuses, to stderr.
            result["status_not_set"] = args.status
    return result


def cmd_update(args) -> dict:
    if args.points is None and not args.sprint:
        acli.die("update needs --points or --sprint", acli.ExitCode.USAGE)
    issue = _request(args, "GET", f"/rest/api/3/issue/{args.issue}?fields=project")
    key = issue["key"]
    result: dict = {"key": key, "url": f"{args.site}/browse/{key}"}
    fields = _planning_fields(args, issue["fields"]["project"]["key"], result)
    if args.dry_run:
        return {**result, "dry_run": True, "fields": fields}
    _request(args, "PUT", f"/rest/api/3/issue/{key}", {"fields": fields})
    return result


def cmd_transition(args) -> dict:
    status = _transition(args, args.issue, args.status, dry_run=args.dry_run)
    result = {"key": args.issue, "status": status}
    if args.dry_run:
        result["dry_run"] = True
    return result


# --- wiring ---------------------------------------------------------------

TABLE_VERBS = {"search", "sprints"}
_PROJECT_KEY = re.compile(r"[A-Za-z][A-Za-z0-9_]*")


def project_key(value: str) -> str:
    """A project key (AIP); it becomes a request query value."""
    if not _PROJECT_KEY.fullmatch(value):
        raise argparse.ArgumentTypeError(f"not a project key like AIP: {value!r}")
    return value


def story_points(value: str) -> float:
    points = float(value)
    if not (0 < points < float("inf")):
        raise argparse.ArgumentTypeError(f"story points must be positive: {value!r}")
    return points


def _add_planning_args(sub) -> None:
    sub.add_argument(
        "--points",
        type=story_points,
        help="Story points to set.",
    )
    sub.add_argument(
        "--points-field",
        default="Story Points",
        metavar="NAME",
        help="Display name of the field --points sets.",
    )
    sub.add_argument(
        "--sprint",
        metavar="NAME",
        help="Sprint to place the issue in: a sprint name, or `active` for the "
        "project's only active sprint (see the sprints verb).",
    )
    sub.add_argument(
        "--dry-run",
        action="store_true",
        help="Resolve --points and --sprint and show the fields; change nothing.",
    )


def build_parser():
    parser = acli.argument_parser(
        prog="jira",
        description=__doc__.split("\n\n")[0],
        capabilities=CAPABILITIES,
        exit_codes=EXIT_CODES,
    )
    parser.add_argument(
        "--site",
        default=None,
        help=f"Jira base URL (default: JIRA_SITE from the environment or {KEYS_FILE}).",
    )
    parser.add_argument(
        "--email",
        default=None,
        help="Atlassian account email for basic auth (default: JIRA_EMAIL "
        f"from the environment or {KEYS_FILE}).",
    )
    parser.add_argument(
        "--timeout", type=float, default=60.0, help="Per-request timeout in seconds."
    )
    subs = parser.add_subparsers(dest="verb", required=True)

    subs.add_parser("whoami", help="Verify the credential and report the account.")

    get = subs.add_parser("get", help="Fetch an issue (key or id) and its comments.")
    get.add_argument("issue", type=issue_ref, help="Issue key like AIP-2747.")

    search = subs.add_parser("search", help="Run a JQL search.")
    search.add_argument("jql", help="JQL, e.g. 'text ~ \"PII LP\"'")
    search.add_argument("--limit", type=int, default=25)

    comment = subs.add_parser(
        "comment", help="Add one comment to an issue; never edits existing ones."
    )
    comment.add_argument("issue", type=issue_ref, help="Issue key like AIP-2747.")
    comment.add_argument(
        "--body-file",
        required=True,
        metavar="FILE",
        help="Comment in Jira wiki markup, or Markdown with --markdown; "
        "- reads standard input.",
    )
    comment.add_argument(
        "--markdown",
        action="store_true",
        help="Read the body as Markdown, as create's description is; tables "
        "stay literal text, so use wiki markup for them.",
    )
    comment.add_argument(
        "--dry-run",
        action="store_true",
        help="Read and size the body, post nothing.",
    )

    sprints = subs.add_parser(
        "sprints", help="List a project's active and future sprints."
    )
    sprints.add_argument("project", type=project_key, help="Project key like AIP.")

    create = subs.add_parser(
        "create", help="File one issue, assigned to you unless --assignee none."
    )
    create.add_argument("project", type=project_key, help="Project key like AIP.")
    create.add_argument("--summary", required=True, help="The issue's title line.")
    create.add_argument("--type", default="Story", help="Issue type name.")
    create.add_argument(
        "--description-file",
        metavar="FILE",
        help="Description in Markdown (headings, lists, fenced code, bold, "
        "emphasis, inline code, links); - reads standard input.",
    )
    create.add_argument("--assignee", choices=("me", "none"), default="me")
    create.add_argument(
        "--status",
        metavar="NAME",
        help="Status to move the new issue to, e.g. 'In Progress'. If one "
        "workflow step cannot reach it, the issue is still created and the "
        "result carries status_not_set.",
    )
    _add_planning_args(create)

    update = subs.add_parser("update", help="Set an issue's story points or sprint.")
    update.add_argument("issue", type=issue_ref, help="Issue key like AIP-2747.")
    _add_planning_args(update)

    transition = subs.add_parser(
        "transition", help="Move an issue one workflow step to a named status."
    )
    transition.add_argument("issue", type=issue_ref, help="Issue key like AIP-2747.")
    transition.add_argument("status", help="Target status, e.g. 'QA Ready'.")
    transition.add_argument(
        "--dry-run",
        action="store_true",
        help="Resolve the workflow step and report its status; move nothing.",
    )

    for sub in subs.choices.values():
        acli.add_standard_args(sub, allow_toon=True)
    acli.add_standard_args(parser, allow_toon=True)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    acli.maybe_complete(parser)
    args = parser.parse_args(argv)
    args.acli_toon_allowed = args.verb in TABLE_VERBS
    try:
        fmt = acli.resolve_format(args)
    except ValueError as err:
        acli.die(str(err), acli.ExitCode.USAGE)
    args.site = (args.site or _setting(SITE_VARS, "Jira site URL")).rstrip("/")
    args.email = args.email or _setting(EMAIL_VARS, "Atlassian account email")
    handler = globals()[f"cmd_{args.verb}"]
    result = handler(args)
    acli.emit(result, fmt, commentary=not getattr(args, "no_commentary", False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
