{
	"formatVersion": 1,
	"kind": "base",
	"status": "ready",
	"id": "repo-view",
	"title": "Repository web view",
	"description": "Browse the repository's documents as linked web pages, live or as a publishable static site; enable it as the project's app when wanted.",
	"extends": ["base"],
	"files": [
		{ "to": "AGENTS.md", "from": "instructions.md" },
		{ "to": "instructions/repo-view.md", "from": "guide.md" },
		{
			"to": "scripts/repo_view.py",
			"from": "files/repo_view.py",
			"executable": true
		},
		{ "to": "scripts/table_notes.lua", "from": "files/table_notes.lua" },
		{
			"to": "scripts/repo_view_actions.js",
			"from": "files/repo_view_actions.js"
		},
		{
			"to": "scripts/repo_view_actions.css",
			"from": "files/repo_view_actions.css"
		},
		{
			"to": "scripts/repo_view_fresh.js",
			"from": "files/repo_view_fresh.js"
		}
	],
	"overrides": []
}
